<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:BlackEngine.ViewModels"
        xmlns:controls="using:BlackEngine.Controls"
        mc:Ignorable="d"
        x:Class="BlackEngine.MainWindow"
        x:CompileBindings="False"
        x:Name="RootWindow"
        Width="450"
        Height="800"
        MinWidth="380"
        MinHeight="650"
        Title="BlackEngine"
        Icon="/Assets/icon.png"
        Background="{Binding WindowBackgroundString}"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="-1">


    <Window.DataContext>
        <vm:MainWindowViewModel/>
    </Window.DataContext>

    <Grid>
        <!-- CONTENIDO PRINCIPAL -->
        <Grid RowDefinitions="Auto,*" Margin="20,50,20,15">

            <!-- CABECERA EN DOS FILAS: FILA 0: LOGO Y AJUSTES | FILA 1: TABS ALINEADOS AL CENTRO -->
            <Grid Grid.Row="0" RowDefinitions="Auto,Auto" Margin="0,0,0,22">
                
                <!-- FILA 0: LOGO Y AJUSTES -->
                <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                    
                    <!-- LOGO BRUTALISTA DE BLACKENGINE -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <!-- Icono de doble rombo rotado minimalista superpuesto -->
                        <Grid Width="16" Height="16" VerticalAlignment="Center">
                            <!-- Rombo de acento oscuro de fondo -->
                            <Border Width="8" Height="8" BorderBrush="#444446" BorderThickness="1" CornerRadius="1.5" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                <Border.RenderTransform>
                                    <RotateTransform Angle="45"/>
                                </Border.RenderTransform>
                            </Border>
                            <!-- Rombo de luz frontal -->
                            <Border Width="8" Height="8" Background="White" BorderBrush="White" BorderThickness="1" CornerRadius="1.5" HorizontalAlignment="Left" VerticalAlignment="Top">
                                <Border.RenderTransform>
                                    <RotateTransform Angle="45"/>
                                </Border.RenderTransform>
                            </Border>
                        </Grid>
                        <TextBlock Text="BlackEngine" FontSize="12.5" FontWeight="Black" LetterSpacing="0.8" Foreground="White" FontFamily="Inter, -apple-system, BlinkMacSystemFont, sans-serif" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- ESPACIADOR -->
                    <Grid Grid.Column="1"/>

                    <!-- BOTÓN AJUSTES TIPOGRÁFICO PREMIUM (Slide Trigger) -->
                    <Button Grid.Column="2"
                            Command="{Binding ToggleSettingsCommand}"
                            Background="Transparent"
                            BorderBrush="#1C1C1E"
                            BorderThickness="1"
                            Width="30"
                            Height="30"
                            CornerRadius="6"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                        <TextBlock Text="⚙" FontSize="11" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                </Grid>
                
                <!-- FILA 1: PESTAÑAS (TABS) CENTRADAS MÁS ABAJO -->
                <ListBox Grid.Row="1"
                         ItemsSource="{Binding Tabs}"
                         SelectedItem="{Binding SelectedTab, Mode=TwoWay}"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="0"
                         HorizontalAlignment="Center"
                         Margin="0,18,0,0">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="25"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                            <Setter Property="Padding" Value="0,4"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="#505050"/>
                            <Setter Property="FontSize" Value="9.5"/>
                            <Setter Property="FontWeight" Value="Black"/>
                            <Setter Property="LetterSpacing" Value="2"/>
                            <Setter Property="Transitions">
                                <Transitions>
                                    <BrushTransition Property="Foreground" Duration="0:0:0.12"/>
                                </Transitions>
                            </Setter>
                        </Style>
                        <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="#909090"/>
                        </Style>
                        <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Style>
                        <Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Style>
                    </ListBox.Styles>
                </ListBox>
            </Grid>

            <!-- VISTA DE PANELES MULTICAPA -->
            <Grid Grid.Row="1">

                <!-- ================= VISTA 1: GALERÍA ================= -->
                <Grid RowDefinitions="Auto,*" IsVisible="{Binding IsGalleryTabVisible}">
                    
                    <!-- BUSCADOR MINIMALISTA + FILTRO PREMIUM POPUP + SPOTLIGHT DIRECT SHORTCUT -->
                    <Border Grid.Row="0"
                            Background="#09090B"
                            BorderBrush="#18181B"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12,3"
                            Margin="0,0,0,12">
                        <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto">
                            <TextBlock Grid.Column="0"
                                       Text="⚲ SEARCH"
                                       Foreground="#52525B"
                                       FontSize="8"
                                       FontWeight="Black"
                                       LetterSpacing="1.5"
                                       VerticalAlignment="Center"
                                       Margin="0,0,14,0"
                                       FontFamily="Inter, -apple-system, BlinkMacSystemFont, Segoe UI, Roboto, sans-serif"/>
                            <!-- Contador técnico de catálogo -->
                            <Border Grid.Column="1"
                                    Background="#18181B"
                                    BorderBrush="#27272A"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="6,2"
                                    Margin="0,0,14,0"
                                    VerticalAlignment="Center"
                                    IsVisible="{Binding Wallpapers.Count}">
                                <TextBlock Text="{Binding CatalogCountText}" FontSize="7" FontWeight="Black" Foreground="#A1A1AA" FontFamily="monospace"/>
                            </Border>
                            <TextBox Grid.Column="2"
                                     PlaceholderText="Buscar obras, autores o categorías..."
                                     Text="{Binding SearchText, Mode=TwoWay}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="White"
                                     FontSize="12"
                                     Padding="0,1,0,0"
                                     VerticalAlignment="Center"
                                     VerticalContentAlignment="Center"
                                     FontFamily="Inter, -apple-system, BlinkMacSystemFont, Segoe UI, Roboto, sans-serif"/>
                            
                            <!-- BOTÓN DE FILTRO FLYOUT (DESPLEGABLE MINIMALISTA Y ESPECTACULAR) -->
                            <Button Grid.Column="3"
                                    Background="Transparent"
                                    BorderBrush="Transparent"
                                    BorderThickness="0"
                                    Width="32"
                                    Height="32"
                                    CornerRadius="6"
                                    VerticalAlignment="Center"
                                    Margin="0,0,4,0">
                                <TextBlock Text="⌥" FontSize="12" Foreground="#A1A1AA" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Button.Flyout>
                                    <Flyout Placement="BottomEdgeAlignedRight" ShowMode="Standard">
                                        <Border Background="#0C0C0E"
                                                BorderBrush="#1C1C1E"
                                                BorderThickness="1"
                                                CornerRadius="10"
                                                Padding="14"
                                                Width="240"
                                                BoxShadow="0 10 30 0 #A0000000">
                                            <StackPanel Spacing="14">
                                                <!-- DISPOSITIVO -->
                                                <StackPanel Spacing="6">
                                                    <TextBlock Text="FILTRAR POR DISPOSITIVO" FontSize="7.5" FontWeight="Black" LetterSpacing="1.5" Foreground="#52525B"/>
                                                    <ListBox ItemsSource="{Binding DeviceFilters}"
                                                             SelectedItem="{Binding SelectedDeviceFilter, Mode=TwoWay}"
                                                             Background="Transparent"
                                                             BorderThickness="0"
                                                             Padding="0">
                                                        <ListBox.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <UniformGrid Columns="3"/>
                                                            </ItemsPanelTemplate>
                                                        </ListBox.ItemsPanel>
                                                        <ListBox.Styles>
                                                            <Style Selector="ListBoxItem">
                                                                <Setter Property="Padding" Value="0,6"/>
                                                                <Setter Property="Background" Value="#18181B"/>
                                                                <Setter Property="Foreground" Value="#71717A"/>
                                                                <Setter Property="FontSize" Value="8.5"/>
                                                                <Setter Property="FontWeight" Value="Bold"/>
                                                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                                                                <Setter Property="CornerRadius" Value="4"/>
                                                                <Setter Property="BorderThickness" Value="1"/>
                                                                <Setter Property="BorderBrush" Value="#27272A"/>
                                                                <Setter Property="Margin" Value="2"/>
                                                            </Style>
                                                            <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                                                                <Setter Property="Background" Value="#27272A"/>
                                                                <Setter Property="Foreground" Value="White"/>
                                                            </Style>
                                                            <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                                                                <Setter Property="Background" Value="White"/>
                                                                <Setter Property="Foreground" Value="Black"/>
                                                                <Setter Property="BorderBrush" Value="White"/>
                                                            </Style>
                                                        </ListBox.Styles>
                                                    </ListBox>
                                                </StackPanel>

                                                <!-- DIVIDER -->
                                                <Border Height="1" Background="#1C1C1E"/>

                                                <!-- CATEGORÍA -->
                                                <StackPanel Spacing="6">
                                                    <TextBlock Text="FILTRAR POR ESTILO / CATEGORÍA" FontSize="7.5" FontWeight="Black" LetterSpacing="1.5" Foreground="#52525B"/>
                                                    <ListBox ItemsSource="{Binding Categories}"
                                                             SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                                                             Background="Transparent"
                                                             BorderThickness="0"
                                                             Padding="0">
                                                        <ListBox.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <WrapPanel ItemWidth="68" ItemHeight="26"/>
                                                            </ItemsPanelTemplate>
                                                        </ListBox.ItemsPanel>
                                                        <ListBox.Styles>
                                                            <Style Selector="ListBoxItem">
                                                                <Setter Property="Padding" Value="2,4"/>
                                                                <Setter Property="Background" Value="#18181B"/>
                                                                <Setter Property="Foreground" Value="#71717A"/>
                                                                <Setter Property="FontSize" Value="8"/>
                                                                <Setter Property="FontWeight" Value="Bold"/>
                                                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                                                                <Setter Property="CornerRadius" Value="4"/>
                                                                <Setter Property="BorderThickness" Value="1"/>
                                                                <Setter Property="BorderBrush" Value="#27272A"/>
                                                                <Setter Property="Margin" Value="2"/>
                                                            </Style>
                                                            <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                                                                <Setter Property="Background" Value="#27272A"/>
                                                                <Setter Property="Foreground" Value="White"/>
                                                            </Style>
                                                            <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                                                                <Setter Property="Background" Value="White"/>
                                                                <Setter Property="Foreground" Value="Black"/>
                                                                <Setter Property="BorderBrush" Value="White"/>
                                                            </Style>
                                                        </ListBox.Styles>
                                                    </ListBox>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                            
                            <!-- BOTÓN MODO PRESENTACIÓN AMBIENT SLIDESHOW (📺) -->
                            <Button Grid.Column="4"
                                    Command="{Binding ToggleSlideshowCommand}"
                                    Background="Transparent"
                                    BorderBrush="Transparent"
                                    BorderThickness="0"
                                    Width="32"
                                    Height="32"
                                    CornerRadius="6"
                                    VerticalAlignment="Center"
                                    Margin="0,0,4,0"
                                    ToolTip.Tip="INICIAR PRESENTACIÓN AMBIENTAL (📺)">
                                <TextBlock Text="📺" FontSize="11" Foreground="#A1A1AA" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>

                            <Button Grid.Column="5"
                                    Command="{Binding ToggleSpotlightCommand}"
                                    Background="#18181B"
                                    BorderBrush="#27272A"
                                    BorderThickness="1"
                                    Padding="8,4"
                                    CornerRadius="4"
                                    VerticalAlignment="Center">
                                <TextBlock Text="⌘K" FontSize="8" FontWeight="Black" Foreground="White"/>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- ESTADO VACÍO INICIAL MINIMALISTA -->
                    <StackPanel Grid.Row="1"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Spacing="16"
                                IsVisible="{Binding !Wallpapers.Count}"
                                Margin="0,80,0,80">
                        <Grid Width="24" Height="24" HorizontalAlignment="Center">
                            <Ellipse Width="8" Height="8" Fill="#71717A" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Ellipse Width="24" Height="24" Stroke="#27272A" StrokeThickness="1" StrokeDashArray="3,3"/>
                        </Grid>
                        <StackPanel Spacing="4">
                            <TextBlock Text="GALERÍA SIN CONTENIDO" FontSize="9" FontWeight="Black" LetterSpacing="2" Foreground="#8A8A8E" HorizontalAlignment="Center" FontFamily="Inter, -apple-system, sans-serif"/>
                            <TextBlock Text="Conecta tu GITHUB CLOUD ENGINE en el menú de ajustes ⚙"
                                       FontSize="10"
                                       Foreground="#52525B"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"
                                       FontFamily="Inter, -apple-system, sans-serif"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- GRILLA DE IMÁGENES -->
                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding Wallpapers}"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="0"
                             IsVisible="{Binding Wallpapers.Count}">
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="Background" Value="Transparent"/>
                            </Style>
                            <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                                <Setter Property="Background" Value="Transparent"/>
                            </Style>
                            <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                                <Setter Property="Background" Value="Transparent"/>
                            </Style>
                            <Style Selector="ListBoxItem:pointerover Border.WpCard">
                                <Setter Property="BorderBrush" Value="#444449"/>
                            </Style>
                        </ListBox.Styles>
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="2"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Classes="WpCard"
                                        Height="285"
                                        Margin="6"
                                        CornerRadius="14"
                                        ClipToBounds="True"
                                        Background="#09090B"
                                        BorderBrush="#18181B"
                                        BorderThickness="1">
                                    <Grid>
                                        <!-- CLIC EN IMAGEN -->
                                        <Button Command="{Binding #RootWindow.DataContext.SelectWallpaperCommand}"
                                                CommandParameter="{Binding}"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Padding="0"
                                                HorizontalAlignment="Stretch"
                                                VerticalAlignment="Stretch"
                                                HorizontalContentAlignment="Stretch"
                                                VerticalContentAlignment="Stretch">
                                            <Grid>
                                                <!-- IMAGEN -->
                                                <Image Source="{Binding ImageBitmap}"
                                                       Stretch="UniformToFill"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                                
                                                <!-- DEGRADADO INFERIOR DE PROTECCIÓN -->
                                                <Border VerticalAlignment="Bottom" Height="80">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                            <GradientStop Color="#00000000" Offset="0"/>
                                                            <GradientStop Color="#EE08080A" Offset="1"/>
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                </Border>
                                            </Grid>
                                        </Button>

                                        <!-- PAPELERA ADMINISTRATIVA FLOTANTE (SOLO VISIBLE PARA NIVEL A: CREADOR) -->
                                        <Button Command="{Binding #RootWindow.DataContext.DeleteWallpaperCommand}"
                                                CommandParameter="{Binding}"
                                                IsVisible="{Binding #RootWindow.DataContext.IsLevelA}"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Top"
                                                Margin="8"
                                                Width="30"
                                                Height="30"
                                                CornerRadius="6"
                                                Background="#EEFF3B30"
                                                BorderBrush="#FF3B30"
                                                BorderThickness="1">
                                            <TextBlock Text="×" FontSize="14" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Button>

                                        <!-- BOTÓN FAVORITO FLOTANTE -->
                                        <ToggleButton IsChecked="{Binding IsFavorite, Mode=TwoWay}"
                                                      Command="{Binding #RootWindow.DataContext.ToggleFavoriteCommand}"
                                                      CommandParameter="{Binding}"
                                                      HorizontalAlignment="Right"
                                                      VerticalAlignment="Top"
                                                      Margin="8"
                                                      Width="30"
                                                      Height="30"
                                                      CornerRadius="6"
                                                      Background="#CC08080C"
                                                      BorderBrush="#1C1C1E"
                                                      BorderThickness="1">
                                            <ToggleButton.Styles>
                                                <Style Selector="ToggleButton:checked /template/ ContentPresenter">
                                                    <Setter Property="Background" Value="White"/>
                                                    <Setter Property="Foreground" Value="Black"/>
                                                    <Setter Property="BorderBrush" Value="White"/>
                                                </Style>
                                                <Style Selector="ToggleButton:not(:checked) /template/ ContentPresenter">
                                                    <Setter Property="Background" Value="#CC08080C"/>
                                                    <Setter Property="Foreground" Value="#707070"/>
                                                    <Setter Property="BorderBrush" Value="#1C1C1E"/>
                                                </Style>
                                            </ToggleButton.Styles>
                                            <TextBlock Text="❤" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </ToggleButton>

                                        <!-- DETALLES DE CARTA -->
                                        <Grid VerticalAlignment="Bottom"
                                              Margin="10"
                                              ColumnDefinitions="*,Auto"
                                              IsHitTestVisible="False">
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}"
                                                           FontSize="12"
                                                           FontWeight="Bold"
                                                           Foreground="White"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Author}"
                                                           FontSize="9"
                                                           Foreground="#707070"
                                                           Margin="0,1,0,0"/>
                                            </StackPanel>
                                            
                                            <!-- CHIP DE DISPOSITIVO / CATEGORÍA -->
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                <Border Padding="4,2" Background="#1C1C1E" CornerRadius="3">
                                                    <TextBlock Text="{Binding DeviceType}" FontSize="7" FontWeight="Black" Foreground="#A0A0A0"/>
                                                </Border>
                                                <Border Padding="4,2" Background="#2C2C2E" CornerRadius="3">
                                                    <TextBlock Text="{Binding Category}" FontSize="7" FontWeight="Bold" Foreground="White"/>
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>

                <!-- ================= VISTA 2: COLOR WHEEL 3D ================= -->
                <Grid RowDefinitions="Auto,*,Auto" IsVisible="{Binding IsColorTabVisible}" Margin="10,0,10,0">
                    
                    <!-- TEXTO DE INSTRUCCIONES -->
                    <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,5,0,0">
                        <TextBlock Text="COLOR SPHERE 3D"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   LetterSpacing="3"
                                   Foreground="White"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Arrastra para rotar la esfera. Clica una partícula para seleccionar."
                                   FontSize="11"
                                   Foreground="#707070"
                                   Margin="0,4,0,0"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>

                    <!-- CONTENEDOR CENTRAL DE LA RUEDA 3D CON BRÚJULA TÉCNICA (Súper Responsivo) -->
                    <Border Grid.Row="1"
                            VerticalAlignment="Stretch"
                            HorizontalAlignment="Stretch"
                            Background="Transparent"
                            Margin="0,10,0,10">
                        <Viewbox Stretch="Uniform" MaxWidth="320" MaxHeight="320" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Grid Width="330" Height="330">
                                <!-- Concentric thin circles -->
                                <Ellipse Width="330" Height="330" Stroke="#151518" StrokeThickness="1" StrokeDashArray="3,3"/>
                                <Ellipse Width="260" Height="260" Stroke="#151518" StrokeThickness="1" StrokeDashArray="3,3"/>
                                <Ellipse Width="190" Height="190" Stroke="#151518" StrokeThickness="1" StrokeDashArray="3,3"/>
                                <Ellipse Width="120" Height="120" Stroke="#151518" StrokeThickness="1" StrokeDashArray="3,3"/>
                                
                                <!-- Technical Crosshair axes -->
                                <Line StartPoint="165,0" EndPoint="165,330" Stroke="#151518" StrokeThickness="1" StrokeDashArray="4,4"/>
                                <Line StartPoint="0,165" EndPoint="330,165" Stroke="#151518" StrokeThickness="1" StrokeDashArray="4,4"/>
                                
                                <!-- Precise Angle HUD Labels -->
                                <TextBlock Text="N  0°" FontSize="6.5" FontWeight="Black" Foreground="#444449" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,5,0,0" FontFamily="monospace"/>
                                <TextBlock Text="E  90°" FontSize="6.5" FontWeight="Black" Foreground="#444449" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,5,0" FontFamily="monospace"/>
                                <TextBlock Text="S  180°" FontSize="6.5" FontWeight="Black" Foreground="#444449" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,5" FontFamily="monospace"/>
                                <TextBlock Text="W  270°" FontSize="6.5" FontWeight="Black" Foreground="#444449" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="5,0,0,0" FontFamily="monospace"/>
                                
                                <!-- Actual 3D sphere component -->
                                <controls:ColorWheelControl SelectedColor="{Binding SelectedSolidColor, Mode=TwoWay}"
                                                           HorizontalAlignment="Stretch"
                                                           VerticalAlignment="Stretch"/>
                            </Grid>
                        </Viewbox>
                    </Border>

                    <!-- DECK DE CALIBRACIÓN ULTRA PREMIUM (MEDIO CÍRCULO / PANEL ESFEROIDAL BRUTALISTA) -->
                    <Border Grid.Row="2"
                            Background="#0A0A0C"
                            BorderBrush="#1C1C1F"
                            BorderThickness="1,1,1,0"
                            CornerRadius="24,24,0,0"
                            Padding="18,16,18,16"
                            Margin="-10,0,-10,0">
                        <StackPanel Spacing="14">
                            
                            <!-- Sección 1: Calibrador de Medio Círculo (sRGB Arc Dial) -->
                            <Grid HorizontalAlignment="Center" Height="52" Width="120" Margin="0,0,0,6">
                                <!-- Concentric dashed calibration arches -->
                                <Path Data="M 5,45 A 50,50 0 0,1 115,45" Stroke="#161619" StrokeThickness="1.5" StrokeDashArray="3,3" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Path Data="M 15,45 A 40,40 0 0,1 105,45" Stroke="#202024" StrokeThickness="1" StrokeDashArray="2,2" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Path Data="M 25,45 A 30,30 0 0,1 95,45" Stroke="{Binding SelectedSolidColorBrush}" StrokeThickness="0.75" Opacity="0.5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                
                                <!-- Dynamic Glowing Core (Medio Círculo / Esfera Principal) -->
                                <Border Width="24" Height="24" CornerRadius="12" 
                                        Background="{Binding SelectedSolidColorBrush}" 
                                        BorderBrush="#2A2A2F" BorderThickness="1"
                                        HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,6">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="12" Color="{Binding SelectedSolidColor}" Opacity="0.4"/>
                                    </Border.Effect>
                                </Border>

                                <!-- Complementary Miniature Bubble (Acento del Diseñador) -->
                                <Border Width="10" Height="10" CornerRadius="5"
                                        Background="{Binding ComplementarySolidColorBrush}"
                                        BorderBrush="#1C1C1F" BorderThickness="1"
                                        HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,25,6"
                                        ToolTip.Tip="COLOR COMPLEMENTARIO ARMÓNICO">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="4" Color="{Binding SelectedSolidColor}" Opacity="0.4"/>
                                    </Border.Effect>
                                </Border>
                                
                                <!-- Tech Specs & Calibration Scale -->
                                <TextBlock Text="0%" FontSize="5.5" FontWeight="Bold" Foreground="#3F3F46" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="4,0,0,4" FontFamily="monospace"/>
                                <TextBlock Text="100%" FontSize="5.5" FontWeight="Bold" Foreground="#3F3F46" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,4,4" FontFamily="monospace"/>
                                <TextBlock Text="sRGB ARC" FontSize="5.5" FontWeight="Black" LetterSpacing="1" Foreground="#52525B" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,1,0,0" FontFamily="monospace"/>
                            </Grid>

                            <!-- Sección 2: Cabecera del Panel (HEX Input y Dynamic Contrast) -->
                            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                <!-- Dynamic Contrast Checker (WCAG Standard) -->
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="ANALIZADOR DE CONTRASTE WCAG" FontSize="6.5" FontWeight="Black" LetterSpacing="1.2" Foreground="#52525B"/>
                                    <TextBlock Text="{Binding ContrastRatioText}" FontSize="8.5" FontWeight="Bold" Foreground="#A1A1AA" FontFamily="monospace" Margin="0,1,0,0"/>
                                </StackPanel>

                                <!-- INPUT HEXADECIMAL DEL DISEÑADOR (Interactive Hex Input) -->
                                <Border Grid.Column="1" 
                                        Background="#111113" 
                                        BorderBrush="#252528"
                                        BorderThickness="1"
                                        CornerRadius="6" 
                                        Padding="8,4" 
                                        VerticalAlignment="Center" 
                                        Width="105">
                                    <Grid ColumnDefinitions="Auto,*">
                                        <TextBlock Grid.Column="0" Text="#" FontSize="10.5" FontWeight="Black" Foreground="#52525B" VerticalAlignment="Center" Margin="0,0,3,0"/>
                                        <TextBox Grid.Column="1"
                                                 Text="{Binding CustomHexInput, Mode=TwoWay}"
                                                 PlaceholderText="FFFFFF"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 Foreground="White"
                                                 FontSize="10"
                                                 FontFamily="monospace"
                                                 Padding="0"
                                                 VerticalAlignment="Center"
                                                 VerticalContentAlignment="Center"
                                                 Height="16"/>
                                    </Grid>
                                </Border>
                            </Grid>

                            <!-- Divider Fino -->
                            <Border Height="1" Background="#161619"/>

                            <!-- Sección 3: Ajuste de Brillo HSL y Ruido Táctil en una Grilla -->
                            <Grid RowDefinitions="Auto" ColumnDefinitions="*,*" Margin="0,2,0,2">
                                
                                <!-- Calibrador de Brillo HSL (Col 0) -->
                                <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,8,0">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0" Text="BRILLO HSL" FontSize="7" FontWeight="Black" LetterSpacing="1" Foreground="#52525B"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Lightness, StringFormat={}{0:F0}%}" FontSize="8" FontWeight="Bold" Foreground="#71717A" FontFamily="monospace"/>
                                    </Grid>
                                    <Slider Minimum="0" 
                                            Maximum="100" 
                                            Value="{Binding Lightness, Mode=TwoWay}"
                                            Foreground="White"
                                            Height="20"
                                            VerticalAlignment="Center"/>
                                </StackPanel>

                                <!-- Selector de Ruido Táctil (Col 1) -->
                                <StackPanel Grid.Column="1" Spacing="4" Margin="8,0,0,0">
                                    <TextBlock Text="RUIDO TÁCTIL (PAPEL ORGÁNICO)" FontSize="7" FontWeight="Black" LetterSpacing="1" Foreground="#52525B"/>
                                    <Border Background="#111113" Padding="2" CornerRadius="6" VerticalAlignment="Center">
                                        <Grid ColumnDefinitions="*,*,*">
                                            <ToggleButton Grid.Column="0" Content="OFF"
                                                          IsChecked="{Binding IsGrainNone, Mode=OneWay}"
                                                          Command="{Binding SwitchGrainLevelCommand}"
                                                          CommandParameter="0"
                                                          Height="18"
                                                          CornerRadius="4"
                                                          FontSize="7"
                                                          FontWeight="Black"
                                                          HorizontalContentAlignment="Center"
                                                          VerticalContentAlignment="Center"
                                                          BorderThickness="0">
                                                <ToggleButton.Styles>
                                                    <Style Selector="ToggleButton:checked /template/ ContentPresenter">
                                                        <Setter Property="Background" Value="White"/>
                                                        <Setter Property="Foreground" Value="Black"/>
                                                    </Style>
                                                    <Style Selector="ToggleButton:not(:checked) /template/ ContentPresenter">
                                                        <Setter Property="Background" Value="Transparent"/>
                                                        <Setter Property="Foreground" Value="#505050"/>
                                                    </Style>
                                                </ToggleButton.Styles>
                                            </ToggleButton>
                                            <ToggleButton Grid.Column="1" Content="FINO"
                                                          IsChecked="{Binding IsGrainFine, Mode=OneWay}"
                                                          Command="{Binding SwitchGrainLevelCommand}"
                                                          CommandParameter="1"
                                                          Height="18"
                                                          CornerRadius="4"
                                                          FontSize="7"
                                                          FontWeight="Black"
                                                          HorizontalContentAlignment="Center"
                                                          VerticalContentAlignment="Center"
                                                          BorderThickness="0">
                                                <ToggleButton.Styles>
                                                    <Style Selector="ToggleButton:checked /template/ ContentPresenter">
                                                        <Setter Property="Background" Value="White"/>
                                                        <Setter Property="Foreground" Value="Black"/>
                                                    </Style>
                                                    <Style Selector="ToggleButton:not(:checked) /template/ ContentPresenter">
                                                        <Setter Property="Background" Value="Transparent"/>
                                                        <Setter Property="Foreground" Value="#505050"/>
                                                    </Style>
                                                </ToggleButton.Styles>
                                            </ToggleButton>
                                            <ToggleButton Grid.Column="2" Content="TÁCT"
                                                          IsChecked="{Binding IsGrainTactile, Mode=OneWay}"
                                                          Command="{Binding SwitchGrainLevelCommand}"
                                                          CommandParameter="2"
                                                          Height="18"
                                                          CornerRadius="4"
                                                          FontSize="7"
                                                          FontWeight="Black"
                                                          HorizontalContentAlignment="Center"
                                                          VerticalContentAlignment="Center"
                                                          BorderThickness="0">
                                                <ToggleButton.Styles>
                                                    <Style Selector="ToggleButton:checked /template/ ContentPresenter">
                                                        <Setter Property="Background" Value="White"/>
                                                        <Setter Property="Foreground" Value="Black"/>
                                                    </Style>
                                                    <Style Selector="ToggleButton:not(:checked) /template/ ContentPresenter">
                                                        <Setter Property="Background" Value="Transparent"/>
                                                        <Setter Property="Foreground" Value="#505050"/>
                                                    </Style>
                                                </ToggleButton.Styles>
                                            </ToggleButton>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <!-- Divider Fino -->
                            <Border Height="1" Background="#161619"/>

                            <!-- Sección 4: Copiar código de especificación técnica (Specs) -->
                            <StackPanel Spacing="4">
                                <TextBlock Text="COPIAR ESPECIFICACIÓN TÉCNICA (CODE)" FontSize="7" FontWeight="Black" LetterSpacing="1" Foreground="#52525B"/>
                                <Grid ColumnDefinitions="*,*,*">
                                    <Button Grid.Column="0" Command="{Binding CopyCodeCommand}" CommandParameter="CSS"
                                            Background="#111113" Foreground="#A1A1AA" Height="22" Margin="0,0,4,0" CornerRadius="4" BorderBrush="#202023" BorderThickness="1">
                                        <TextBlock Text="CSS CORE" FontSize="7.5" FontWeight="Black" HorizontalAlignment="Center"/>
                                    </Button>
                                    <Button Grid.Column="1" Command="{Binding CopyCodeCommand}" CommandParameter="SWIFT"
                                            Background="#111113" Foreground="#A1A1AA" Height="22" Margin="2,0,2,0" CornerRadius="4" BorderBrush="#202023" BorderThickness="1">
                                        <TextBlock Text="SWIFTUI" FontSize="7.5" FontWeight="Black" HorizontalAlignment="Center"/>
                                    </Button>
                                    <Button Grid.Column="2" Command="{Binding CopyCodeCommand}" CommandParameter="KOTLIN"
                                            Background="#111113" Foreground="#A1A1AA" Height="22" Margin="4,0,0,0" CornerRadius="4" BorderBrush="#202023" BorderThickness="1">
                                        <TextBlock Text="KOTLIN" FontSize="7.5" FontWeight="Black" HorizontalAlignment="Center"/>
                                    </Button>
                                </Grid>
                            </StackPanel>

                            <!-- Divider Fino -->
                            <Border Height="1" Background="#161619"/>

                            <!-- Sección 5: Especificaciones de Render, OLED y Selector PC/CEL -->
                            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="ESPECIFICACIONES DE RENDIMIENTO" FontSize="6.5" FontWeight="Black" LetterSpacing="1" Foreground="#52525B"/>
                                    <!-- Celular Specs -->
                                    <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,1,0,0" IsVisible="{Binding IsSolidFormatMobile}">
                                        <TextBlock Text="CELULAR" FontSize="7.5" FontWeight="Black" Foreground="White"/>
                                        <TextBlock Text="•  1440 × 3200 PX" FontSize="7.5" FontWeight="Bold" Foreground="#71717A" FontFamily="monospace"/>
                                        <TextBlock Text="•" FontSize="8" Foreground="#27272A"/>
                                        <TextBlock Text="{Binding OledSavingText}" FontSize="7.5" FontWeight="Bold" Foreground="#A1A1AA" FontFamily="monospace"/>
                                    </StackPanel>
                                    <!-- PC Specs -->
                                    <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,1,0,0" IsVisible="{Binding IsSolidFormatPc}">
                                        <TextBlock Text="DESKTOP 4K" FontSize="7.5" FontWeight="Black" Foreground="White"/>
                                        <TextBlock Text="•  3840 × 2160 PX" FontSize="7.5" FontWeight="Bold" Foreground="#71717A" FontFamily="monospace"/>
                                        <TextBlock Text="•" FontSize="8" Foreground="#27272A"/>
                                        <TextBlock Text="{Binding OledSavingText}" FontSize="7.5" FontWeight="Bold" Foreground="#A1A1AA" FontFamily="monospace"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- PC / CELULAR Segmented Selector -->
                                <Border Grid.Column="1"
                                        Background="#111113"
                                        Padding="2"
                                        CornerRadius="6"
                                        VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="2">
                                        <ToggleButton Content="CEL"
                                                       IsChecked="{Binding IsSolidFormatMobile, Mode=OneWay}"
                                                       Command="{Binding SwitchSolidFormatCommand}"
                                                       CommandParameter="Móvil"
                                                       Height="20"
                                                       Width="32"
                                                       CornerRadius="4"
                                                       FontSize="7.5"
                                                       FontWeight="Black"
                                                       HorizontalAlignment="Stretch"
                                                       HorizontalContentAlignment="Center"
                                                       VerticalContentAlignment="Center"
                                                       BorderThickness="0">
                                            <ToggleButton.Styles>
                                                <Style Selector="ToggleButton:checked /template/ ContentPresenter">
                                                    <Setter Property="Background" Value="White"/>
                                                    <Setter Property="Foreground" Value="Black"/>
                                                </Style>
                                                <Style Selector="ToggleButton:not(:checked) /template/ ContentPresenter">
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Setter Property="Foreground" Value="#505050"/>
                                                </Style>
                                            </ToggleButton.Styles>
                                        </ToggleButton>
                                        <ToggleButton Content="PC"
                                                       IsChecked="{Binding IsSolidFormatPc, Mode=OneWay}"
                                                       Command="{Binding SwitchSolidFormatCommand}"
                                                       CommandParameter="PC"
                                                       Height="20"
                                                       Width="32"
                                                       CornerRadius="4"
                                                       FontSize="7.5"
                                                       FontWeight="Black"
                                                       HorizontalAlignment="Stretch"
                                                       HorizontalContentAlignment="Center"
                                                       VerticalContentAlignment="Center"
                                                       BorderThickness="0">
                                            <ToggleButton.Styles>
                                                <Style Selector="ToggleButton:checked /template/ ContentPresenter">
                                                    <Setter Property="Background" Value="White"/>
                                                    <Setter Property="Foreground" Value="Black"/>
                                                </Style>
                                                <Style Selector="ToggleButton:not(:checked) /template/ ContentPresenter">
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Setter Property="Foreground" Value="#505050"/>
                                                </Style>
                                            </ToggleButton.Styles>
                                        </ToggleButton>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Botón de descarga limpio y brutalista -->
                            <Button Command="{Binding DownloadSolidColorCommand}"
                                    Background="White"
                                    Foreground="Black"
                                    Height="40"
                                    CornerRadius="6"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    Margin="0,4,0,0">
                                <Button.Styles>
                                    <Style Selector="Button:pointerover /template/ ContentPresenter">
                                        <Setter Property="Background" Value="#E0E0E0"/>
                                        <Setter Property="Foreground" Value="Black"/>
                                    </Style>
                                </Button.Styles>
                                <TextBlock Text="GENERAR WALLPAPER SÓLIDO" FontSize="10.5" FontWeight="Bold" LetterSpacing="1"/>
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>

            </Grid>
        </Grid>

        <!-- PANEL MODAL: VISTA PREVIA DETALLADA + PALETTE EXTRACTOR + PRO TRANSITIONS -->
        <Grid Background="#FC08080C"
              IsVisible="{Binding SelectedWallpaper, Converter={x:Static ObjectConverters.IsNotNull}}"
              ZIndex="100"
              Opacity="1">
            <Grid.Transitions>
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.25"/>
                </Transitions>
            </Grid.Transitions>
            <Grid RowDefinitions="*,Auto" Margin="25,70,25,25">
                
                <!-- PREVISUALIZACIÓN DE IMAGEN -->
                <Border Grid.Row="0"
                        CornerRadius="14"
                        ClipToBounds="True"
                        Background="#121212"
                        BorderBrush="#1C1C1E"
                        BorderThickness="1">
                    <Grid>
                        <Image Source="{Binding SelectedWallpaper.ImageBitmap}"
                               Stretch="Uniform"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>

                        <!-- CUADRÍCULA DE COMPOSICIÓN TÉCNICA / REGLA DE TERCIOS (📐) -->
                        <Grid IsVisible="{Binding IsCompositionGridVisible}"
                              Background="Transparent"
                              IsHitTestVisible="False"
                              VerticalAlignment="Stretch"
                              HorizontalAlignment="Stretch">
                            <Grid RowDefinitions="*,*,*" ColumnDefinitions="*,*,*">
                                <Border Grid.Row="0" Grid.Column="0" BorderBrush="White" BorderThickness="0,0,1,1" Opacity="0.25"/>
                                <Border Grid.Row="0" Grid.Column="1" BorderBrush="White" BorderThickness="0,0,1,1" Opacity="0.25"/>
                                <Border Grid.Row="0" Grid.Column="2" BorderBrush="White" BorderThickness="0,0,0,1" Opacity="0.25"/>
                                
                                <Border Grid.Row="1" Grid.Column="0" BorderBrush="White" BorderThickness="0,0,1,1" Opacity="0.25"/>
                                <Border Grid.Row="1" Grid.Column="1" BorderBrush="White" BorderThickness="0,0,1,1" Opacity="0.25"/>
                                <Border Grid.Row="1" Grid.Column="2" BorderBrush="White" BorderThickness="0,0,0,1" Opacity="0.25"/>
                                
                                <Border Grid.Row="2" Grid.Column="0" BorderBrush="White" BorderThickness="0,0,1,0" Opacity="0.25"/>
                                <Border Grid.Row="2" Grid.Column="1" BorderBrush="White" BorderThickness="0,0,1,0" Opacity="0.25"/>
                            </Grid>

                            <!-- Visor Retículo Central Brutalista -->
                            <Ellipse Width="30" Height="30" Stroke="White" StrokeThickness="1" StrokeDashArray="2,2" Opacity="0.4" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Line StartPoint="-10,0" EndPoint="10,0" Stroke="White" StrokeThickness="1.5" Opacity="0.5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Line StartPoint="0,-10" EndPoint="0,10" Stroke="White" StrokeThickness="1.5" Opacity="0.5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- CAJÓN DE ESPECIFICACIONES TÉCNICAS BLUEPRINT (ⓘ) -->
                        <Border HorizontalAlignment="Right"
                                VerticalAlignment="Stretch"
                                Width="260"
                                Background="#F208080C"
                                BorderBrush="#1C1C1E"
                                BorderThickness="1,0,0,0"
                                IsVisible="{Binding IsTechSpecsDrawerOpen}">
                            <Grid RowDefinitions="Auto,*" Margin="20">
                                <!-- Cabecera Blueprint -->
                                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,20">
                                    <StackPanel Grid.Column="0" Spacing="4">
                                        <TextBlock Text="TECHNICAL BLUEPRINT" FontSize="8" FontWeight="Black" LetterSpacing="2" Foreground="#8E8E93"/>
                                        <TextBlock Text="Ficha Cromática" FontSize="14" FontWeight="Bold" Foreground="White"/>
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Command="{Binding ToggleTechSpecsDrawerCommand}"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Width="30"
                                            Height="30"
                                            CornerRadius="15">
                                        <TextBlock Text="×" FontSize="16" Foreground="#8E8E93" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Button>
                                </Grid>
                                
                                <!-- Contenido Specs -->
                                <ScrollViewer Grid.Row="1">
                                    <StackPanel Spacing="20">
                                        <!-- Dimensión -->
                                        <StackPanel Spacing="6">
                                            <TextBlock Text="DIMENSIONES DE LIENZO" FontSize="7.5" FontWeight="Black" LetterSpacing="1.5" Foreground="#52525B"/>
                                            <Border Background="#121214" BorderBrush="#1C1C1E" BorderThickness="1" CornerRadius="6" Padding="12,10">
                                                <StackPanel Spacing="3">
                                                    <TextBlock Text="{Binding SelectedWpDimensions}" FontSize="12" FontWeight="Bold" Foreground="White" FontFamily="monospace"/>
                                                    <TextBlock Text="Renderizado ultra-nítido sin pérdida" FontSize="8" Foreground="#606062"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                        
                                        <!-- Perfil de Color -->
                                        <StackPanel Spacing="6">
                                            <TextBlock Text="PERFIL DE COLOR &amp; FORMATO" FontSize="7.5" FontWeight="Black" LetterSpacing="1.5" Foreground="#52525B"/>
                                            <Border Background="#121214" BorderBrush="#1C1C1E" BorderThickness="1" CornerRadius="6" Padding="12,10">
                                                <StackPanel Spacing="3">
                                                    <TextBlock Text="sRGB LOSSLESS PNG" FontSize="11" FontWeight="Bold" Foreground="White" FontFamily="monospace"/>
                                                    <TextBlock Text="Profundidad: 8-bit por canal (24-bit RGB)" FontSize="8" Foreground="#606062"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>

                                        <!-- Dominante Emocional -->
                                        <StackPanel Spacing="6">
                                            <TextBlock Text="DOMINANTE EMOCIONAL" FontSize="7.5" FontWeight="Black" LetterSpacing="1.5" Foreground="#52525B"/>
                                            <Border Background="#121214" BorderBrush="#1C1C1E" BorderThickness="1" CornerRadius="6" Padding="12,10">
                                                <StackPanel Spacing="3">
                                                    <TextBlock Text="{Binding SelectedWpMood}" FontSize="11" FontWeight="Bold" Foreground="#34C759" TextWrapping="Wrap"/>
                                                    <TextBlock Text="Calculado mediante firma cromática" FontSize="8" Foreground="#606062"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>

                                        <!-- Contraste Energético -->
                                        <StackPanel Spacing="6">
                                            <TextBlock Text="ENERGÍA CROMÁTICA" FontSize="7.5" FontWeight="Black" LetterSpacing="1.5" Foreground="#52525B"/>
                                            <Border Background="#121214" BorderBrush="#1C1C1E" BorderThickness="1" CornerRadius="6" Padding="12,10">
                                                <StackPanel Spacing="4">
                                                    <TextBlock Text="{Binding SelectedWpColorEnergy}" FontSize="11" FontWeight="Bold" Foreground="White" FontFamily="monospace"/>
                                                    <!-- Minimal Horizontal Progress Bar -->
                                                    <ProgressBar Value="75" Height="2" Minimum="0" Maximum="100" Background="#1C1C1E" Foreground="White" IsIndeterminate="False"/>
                                                    <TextBlock Text="Distribución de peso visual sRGB" FontSize="8" Foreground="#606062"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </Border>

                        
                        <!-- SIMULADOR DE PANTALLA DE BLOQUEO DE ALTA COSTURA (📱) -->
                        <Grid IsVisible="{Binding IsLockScreenOverlayVisible}"
                              Background="Transparent"
                              IsHitTestVisible="False"
                              VerticalAlignment="Stretch"
                              HorizontalAlignment="Stretch">
                            <!-- Lock Icon -->
                            <TextBlock Text="🔒" FontSize="14" Foreground="White" Opacity="0.75" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,35,0,0"/>
                            
                            <!-- Dynamic Clock -->
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,65,0,0" Spacing="2">
                                <TextBlock Text="09:41" FontSize="54" FontWeight="Light" Foreground="White" HorizontalAlignment="Center" LetterSpacing="-0.5" FontFamily="Inter, -apple-system, sans-serif"/>
                                <TextBlock Text="VIERNES, 23 DE MAYO" FontSize="8.5" FontWeight="Bold" LetterSpacing="2.5" Foreground="White" Opacity="0.75" HorizontalAlignment="Center" FontFamily="Inter, -apple-system, BlinkMacSystemFont, sans-serif"/>
                            </StackPanel>
                            
                            <!-- Bottom Home Swipe Bar -->
                            <Border Height="3.5" Width="100" Background="White" CornerRadius="1.75" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,20" Opacity="0.8"/>
                        </Grid>

                        <!-- SIMULADOR DE ESCRITORIO MAC / PC DOCK & MENU (💻) -->
                        <Grid IsVisible="{Binding IsDesktopOverlayVisible}"
                              Background="Transparent"
                              IsHitTestVisible="False"
                              VerticalAlignment="Stretch"
                              HorizontalAlignment="Stretch">
                            
                            <!-- Sleek Top Translucent Mac Menu Bar -->
                            <Border Height="22" VerticalAlignment="Top" Background="#AA08080A" BorderBrush="#1C1C1E" BorderThickness="0,0,0,1">
                                <Grid ColumnDefinitions="Auto,*,Auto" Margin="12,0,12,0">
                                    <!-- Left Menu Links -->
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                        <TextBlock Text="" FontSize="11" Foreground="White" FontWeight="Bold" VerticalAlignment="Center"/>
                                        <TextBlock Text="Finder" FontSize="8" Foreground="White" FontWeight="Black" VerticalAlignment="Center"/>
                                        <TextBlock Text="Archivo" FontSize="8" Foreground="#8E8E93" FontWeight="Bold" VerticalAlignment="Center"/>
                                        <TextBlock Text="Edición" FontSize="8" Foreground="#8E8E93" FontWeight="Bold" VerticalAlignment="Center"/>
                                        <TextBlock Text="Visualización" FontSize="8" Foreground="#8E8E93" FontWeight="Bold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    
                                    <!-- Right Clock Info -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <TextBlock Text="📶" FontSize="8" Foreground="White" VerticalAlignment="Center" Opacity="0.8"/>
                                        <TextBlock Text="🔋 100%" FontSize="7" Foreground="White" FontFamily="monospace" VerticalAlignment="Center" Opacity="0.8"/>
                                        <TextBlock Text="Vie 09:41 AM" FontSize="8" Foreground="White" FontWeight="Black" FontFamily="monospace" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            
                            <!-- Minimal macOS Bottom App Dock -->
                            <Border Height="36" Width="200" VerticalAlignment="Bottom" Margin="0,0,0,10" Background="#AA0E0E12" BorderBrush="#252528" BorderThickness="1" CornerRadius="12">
                                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <!-- Mock App wireframe circular chips with premium glass colors -->
                                    <Border Width="20" Height="20" CornerRadius="10" Background="#FF3B30" BorderBrush="#CCFF3B30" BorderThickness="1"/>
                                    <Border Width="20" Height="20" CornerRadius="10" Background="#34C759" BorderBrush="#CC34C759" BorderThickness="1"/>
                                    <Border Width="20" Height="20" CornerRadius="10" Background="#007AFF" BorderBrush="#CC007AFF" BorderThickness="1"/>
                                    <Border Width="20" Height="20" CornerRadius="10" Background="#FFCC00" BorderBrush="#CCFFCC00" BorderThickness="1"/>
                                    <Border Width="20" Height="20" CornerRadius="10" Background="#AF52DE" BorderBrush="#CCAF52DE" BorderThickness="1"/>
                                    <Border Width="20" Height="20" CornerRadius="10" Background="#5856D6" BorderBrush="#CC5856D6" BorderThickness="1"/>
                                    
                                    <Separator Width="1" Height="14" Background="#2C2C2E" Margin="2,0"/>
                                    <Border Width="20" Height="20" CornerRadius="5" Background="#1C1C1E" BorderBrush="#2C2C2E" BorderThickness="1"/>
                                </StackPanel>
                            </Border>
                            
                            <!-- Aesthetic Calendar Widget floating in upper right corner -->
                            <Border Width="90" Height="90" CornerRadius="14" Background="#AA0E0E12" BorderBrush="#1C1C1E" BorderThickness="1" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,38,15,0">
                                <StackPanel Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="MAYO" FontSize="7.5" FontWeight="Black" LetterSpacing="1" Foreground="#FF3B30" HorizontalAlignment="Center"/>
                                    <TextBlock Text="23" FontSize="26" FontWeight="Light" Foreground="White" HorizontalAlignment="Center" FontFamily="Inter, -apple-system, sans-serif"/>
                                    <TextBlock Text="VIERNES" FontSize="7" FontWeight="Bold" LetterSpacing="0.5" Foreground="#71717A" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                        
                        <!-- Indicador de carga offline -->
                        <Border Background="#AA08080C"
                                CornerRadius="8"
                                Padding="10,6"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                IsVisible="{Binding SelectedWallpaper.ImageBitmap, Converter={x:Static ObjectConverters.IsNull}}">
                            <TextBlock Text="Cargando..." Foreground="#909090" FontSize="12"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- PANEL HUD INFERIOR DE DETALLE -->
                <StackPanel Grid.Row="1" Margin="0,20,0,0" Spacing="12">
                    
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding SelectedWallpaper.Title}"
                                       FontSize="20"
                                       FontWeight="Black"
                                       Foreground="White"/>
                            <TextBlock Text="{Binding SelectedWallpaper.Author}"
                                       FontSize="13"
                                       Foreground="#8E8E93"
                                       FontWeight="Medium"
                                       Margin="0,2,0,0"/>
                        </StackPanel>
                        
                        <!-- Estadísticas B&W -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Spacing="12">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="❤" Foreground="White" FontSize="14" Margin="0,0,4,0"/>
                                <TextBlock Text="{Binding SelectedWallpaper.Likes}" Foreground="#707070" FontSize="12"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="↓" Foreground="White" FontSize="14" Margin="0,0,4,0"/>
                                <TextBlock Text="{Binding SelectedWallpaper.DownloadsCount}" Foreground="#707070" FontSize="12"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <!-- INNOVACIÓN EXCLUSIVA: PALETTE EXTRACTOR (EXTRACTOR DE PALETA ARMÓNICA) -->
                    <StackPanel Spacing="6" Margin="0,4,0,4">
                        <TextBlock Text="PALETA CROMÁTICA ARMÓNICA (CLICA PARA CARGAR EN RUEDA 3D)"
                                   FontSize="8"
                                   FontWeight="Bold"
                                   LetterSpacing="1.2"
                                   Foreground="#606060"/>
                        <ItemsControl ItemsSource="{Binding ExtractedColors}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="8"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding #RootWindow.DataContext.ApplyExtractedColorCommand}"
                                            CommandParameter="{Binding}"
                                            Width="46"
                                            Height="28"
                                            CornerRadius="6"
                                            Background="{Binding}"
                                            BorderBrush="#252528"
                                            BorderThickness="1">
                                        <Button.Styles>
                                            <Style Selector="Button:pointerover">
                                                <Setter Property="BorderBrush" Value="White"/>
                                            </Style>
                                        </Button.Styles>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto,Auto">
                        <!-- BOTÓN DESCARGAR -->
                        <Button Grid.Column="0"
                                Command="{Binding DownloadCommand}"
                                CommandParameter="{Binding SelectedWallpaper}"
                                Background="White"
                                Foreground="Black"
                                Height="45"
                                CornerRadius="8"
                                Margin="0,0,8,0"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center">
                            <Button.Styles>
                                <Style Selector="Button:pointerover /template/ ContentPresenter">
                                    <Setter Property="Background" Value="#E0E0E0"/>
                                    <Setter Property="Foreground" Value="Black"/>
                                </Style>
                            </Button.Styles>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="↓" FontSize="12" FontWeight="Bold"/>
                                <TextBlock Text="DESCARGAR WALLPAPER" FontSize="11" FontWeight="Bold" LetterSpacing="0.5"/>
                            </StackPanel>
                        </Button>

                        <!-- Toggle de favorito -->
                        <ToggleButton Grid.Column="1"
                                      IsChecked="{Binding SelectedWallpaper.IsFavorite, Mode=TwoWay}"
                                      Command="{Binding ToggleFavoriteCommand}"
                                      CommandParameter="{Binding SelectedWallpaper}"
                                      Width="45"
                                      Height="45"
                                      CornerRadius="8"
                                      Margin="0,0,8,0"
                                      Background="#121212"
                                      BorderBrush="#1C1C1E"
                                      BorderThickness="1"
                                      ToolTip.Tip="AÑADIR A FAVORITOS">
                            <ToggleButton.Styles>
                                <Style Selector="ToggleButton:checked /template/ ContentPresenter">
                                    <Setter Property="Background" Value="White"/>
                                    <Setter Property="BorderBrush" Value="White"/>
                                    <Setter Property="Foreground" Value="Black"/>
                                </Style>
                                <Style Selector="ToggleButton:not(:checked) /template/ ContentPresenter">
                                    <Setter Property="Background" Value="#121212"/>
                                    <Setter Property="BorderBrush" Value="#1C1C1E"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Style>
                            </ToggleButton.Styles>
                            <TextBlock Text="❤" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </ToggleButton>

                        <!-- Toggle de simulador lockscreen (📱) -->
                        <ToggleButton Grid.Column="2"
                                      IsChecked="{Binding IsLockScreenOverlayVisible, Mode=TwoWay}"
                                      Width="45"
                                      Height="45"
                                      CornerRadius="8"
                                      Margin="0,0,8,0"
                                      Background="#121212"
                                      BorderBrush="#1C1C1E"
                                      BorderThickness="1"
                                      ToolTip.Tip="SIMULAR PANTALLA DE BLOQUEO iOS">
                            <ToggleButton.Styles>
                                <Style Selector="ToggleButton:checked /template/ ContentPresenter">
                                    <Setter Property="Background" Value="White"/>
                                    <Setter Property="BorderBrush" Value="White"/>
                                    <Setter Property="Foreground" Value="Black"/>
                                </Style>
                                <Style Selector="ToggleButton:not(:checked) /template/ ContentPresenter">
                                    <Setter Property="Background" Value="#121212"/>
                                    <Setter Property="BorderBrush" Value="#1C1C1E"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Style>
                            </ToggleButton.Styles>
                            <TextBlock Text="📱" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </ToggleButton>

                        <!-- Toggle de simulador escritorio (💻) -->
                        <ToggleButton Grid.Column="3"
                                      IsChecked="{Binding IsDesktopOverlayVisible, Mode=TwoWay}"
                                      Width="45"
                                      Height="45"
                                      CornerRadius="8"
                                      Margin="0,0,8,0"
                                      Background="#121212"
                                      BorderBrush="#1C1C1E"
                                      BorderThickness="1"
                                      ToolTip.Tip="SIMULAR ESCRITORIO macOS">
                            <ToggleButton.Styles>
                                <Style Selector="ToggleButton:checked /template/ ContentPresenter">
                                    <Setter Property="Background" Value="White"/>
                                    <Setter Property="BorderBrush" Value="White"/>
                                    <Setter Property="Foreground" Value="Black"/>
                                </Style>
                                <Style Selector="ToggleButton:not(:checked) /template/ ContentPresenter">
                                    <Setter Property="Background" Value="#121212"/>
                                    <Setter Property="BorderBrush" Value="#1C1C1E"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Style>
                            </ToggleButton.Styles>
                            <TextBlock Text="💻" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </ToggleButton>

                        <!-- Toggle de cuadrícula de tercios (📐) -->
                        <ToggleButton Grid.Column="4"
                                      IsChecked="{Binding IsCompositionGridVisible, Mode=TwoWay}"
                                      Width="45"
                                      Height="45"
                                      CornerRadius="8"
                                      Margin="0,0,8,0"
                                      Background="#121212"
                                      BorderBrush="#1C1C1E"
                                      BorderThickness="1"
                                      ToolTip.Tip="REGLA DE COMPOSICIÓN (TERCIOS)">
                            <ToggleButton.Styles>
                                <Style Selector="ToggleButton:checked /template/ ContentPresenter">
                                    <Setter Property="Background" Value="White"/>
                                    <Setter Property="BorderBrush" Value="White"/>
                                    <Setter Property="Foreground" Value="Black"/>
                                </Style>
                                <Style Selector="ToggleButton:not(:checked) /template/ ContentPresenter">
                                    <Setter Property="Background" Value="#121212"/>
                                    <Setter Property="BorderBrush" Value="#1C1C1E"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Style>
                            </ToggleButton.Styles>
                            <TextBlock Text="📐" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </ToggleButton>

                        <!-- Toggle de cajón técnico Blueprint (ⓘ) -->
                        <ToggleButton Grid.Column="5"
                                      IsChecked="{Binding IsTechSpecsDrawerOpen, Mode=TwoWay}"
                                      Width="45"
                                      Height="45"
                                      CornerRadius="8"
                                      Margin="0,0,8,0"
                                      Background="#121212"
                                      BorderBrush="#1C1C1E"
                                      BorderThickness="1"
                                      ToolTip.Tip="ESPECIFICACIONES TÉCNICAS BLUEPRINT">
                            <ToggleButton.Styles>
                                <Style Selector="ToggleButton:checked /template/ ContentPresenter">
                                    <Setter Property="Background" Value="White"/>
                                    <Setter Property="BorderBrush" Value="White"/>
                                    <Setter Property="Foreground" Value="Black"/>
                                </Style>
                                <Style Selector="ToggleButton:not(:checked) /template/ ContentPresenter">
                                    <Setter Property="Background" Value="#121212"/>
                                    <Setter Property="BorderBrush" Value="#1C1C1E"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Style>
                            </ToggleButton.Styles>
                            <TextBlock Text="ⓘ" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </ToggleButton>

                        <!-- Botón cerrar -->
                        <Button Grid.Column="6"
                                Command="{Binding ClosePreviewCommand}"
                                Content="CERRAR"
                                Background="#121212"
                                Foreground="White"
                                BorderBrush="#1C1C1E"
                                BorderThickness="1"
                                FontWeight="Bold"
                                FontSize="11"
                                LetterSpacing="0.5"
                                Width="75"
                                Height="45"
                                CornerRadius="8"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center">
                            <Button.Styles>
                                <Style Selector="Button:pointerover /template/ ContentPresenter">
                                    <Setter Property="Background" Value="#1C1C1E"/>
                                    <Setter Property="BorderBrush" Value="#252528"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Style>
                            </Button.Styles>
                        </Button>
                    </Grid>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- ================= SPOTLIGHT COMMAND CENTER OVERLAY ================= -->
        <Grid Background="#D8000000"
              IsVisible="{Binding IsSpotlightOpen}"
              ZIndex="150">
            <Button Background="Transparent"
                    BorderThickness="0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Command="{Binding ToggleSpotlightCommand}"/>

            <Border Width="380"
                    Height="420"
                    Background="#121212"
                    BorderBrush="#252528"
                    BorderThickness="1"
                    CornerRadius="14"
                    BoxShadow="0 15 40 0 #A0000000"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Margin="0,0,0,100">
                <Grid RowDefinitions="Auto,Auto,*">
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="16,14,16,10">
                        <TextBox Grid.Column="0"
                                 PlaceholderText="Escribe un comando o acción..."
                                 Text="{Binding SpotlightQuery, Mode=TwoWay}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="White"
                                 FontSize="13"
                                 FontWeight="Medium"
                                 Padding="0,6"/>
                        <TextBlock Grid.Column="1"
                                   Text="⌘K"
                                   Foreground="#505050"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"/>
                    </Grid>
                    
                    <Border Grid.Row="1" Height="1" Background="#1C1C1E" Margin="0,0,0,8"/>

                    <ListBox Grid.Row="2"
                             ItemsSource="{Binding SpotlightActions}"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="8,0,8,8">
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,2"/>
                                <Setter Property="Background" Value="Transparent"/>
                            </Style>
                            <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                                <Setter Property="Background" Value="Transparent"/>
                            </Style>
                            <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                                <Setter Property="Background" Value="Transparent"/>
                            </Style>
                        </ListBox.Styles>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding #RootWindow.DataContext.ExecuteSpotlightActionCommand}"
                                        CommandParameter="{Binding}"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        CornerRadius="8"
                                        Padding="10,8"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch">
                                    <Button.Styles>
                                        <Style Selector="Button:pointerover /template/ ContentPresenter">
                                            <Setter Property="Background" Value="#1C1C1E"/>
                                        </Style>
                                    </Button.Styles>
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Grid.Column="0" Spacing="2">
                                            <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" Foreground="White"/>
                                            <TextBlock Text="{Binding Category}" FontSize="8" FontWeight="Bold" Foreground="#707070" LetterSpacing="0.5"/>
                                        </StackPanel>
                                        
                                        <Border Grid.Column="1"
                                                Background="#252528"
                                                CornerRadius="4"
                                                Padding="6,3"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ShortcutText}" FontSize="8" FontWeight="Black" Foreground="#A0A0A0"/>
                                        </Border>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>

        <!-- ================= ADJUSTES COLLAPSIBLE SETTINGS DRAWER (INNOVACIÓN PRO) ================= -->
        <Grid Background="#70000000"
              IsVisible="{Binding IsSettingsOpen}"
              ZIndex="120">
            
            <!-- Clic fuera del Drawer para cerrar -->
            <Button Background="Transparent"
                    BorderThickness="0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Command="{Binding ToggleSettingsCommand}"/>

            <!-- Panel Lateral Deslizable (Settings Drawer) -->
            <Border Width="325"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Stretch"
                    Background="#EC08080C"
                    BorderBrush="#1C1C1E"
                    BorderThickness="1,0,0,0"
                    Padding="20,55,20,20"
                    BoxShadow="-15 0 35 0 #80000000">
                
                <Grid RowDefinitions="Auto,*">
                    <!-- Cabecera del Drawer -->
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,15">
                        <TextBlock Grid.Column="0"
                                   Text="CONFIGURACIÓN"
                                   FontSize="10"
                                   FontWeight="Black"
                                   LetterSpacing="2"
                                   Foreground="White"
                                   VerticalAlignment="Center"/>
                        
                        <Button Grid.Column="1"
                                Command="{Binding ToggleSettingsCommand}"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="4">
                            <TextBlock Text="×" FontSize="18" FontWeight="Black" Foreground="#707070" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </Grid>

                    <!-- Scroll de Opciones -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="16">
                            
                            <!-- SECCIÓN 0: GITHUB CLOUD ENGINE -->
                            <Border Background="#121212"
                                    BorderBrush="#1C1C1E"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="14">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="NUBE GITHUB" FontSize="8" FontWeight="Black" LetterSpacing="2" Foreground="#707070"/>
                                    
                                    <StackPanel Spacing="8">
                                        <StackPanel>
                                            <TextBlock Text="Usuario de GitHub" FontSize="9" Foreground="#606060" Margin="0,0,0,3"/>
                                            <TextBox Text="{Binding GithubUsername, Mode=TwoWay}" PlaceholderText="User..." Height="30" FontSize="11" Background="#1C1C1E" BorderBrush="#252528" Padding="6,4" CornerRadius="5"/>
                                        </StackPanel>

                                        <StackPanel>
                                            <TextBlock Text="Token PAT" FontSize="9" Foreground="#606060" Margin="0,0,0,3"/>
                                            <TextBox Text="{Binding GithubToken, Mode=TwoWay}" PasswordChar="●" PlaceholderText="ghp_..." Height="30" FontSize="11" Background="#1C1C1E" BorderBrush="#252528" Padding="6,4" CornerRadius="5"/>
                                        </StackPanel>

                                        <StackPanel>
                                            <TextBlock Text="Propietario del Repo" FontSize="9" Foreground="#606060" Margin="0,0,0,3"/>
                                            <TextBox Text="{Binding RepoOwner, Mode=TwoWay}" PlaceholderText="Owner..." Height="30" FontSize="11" Background="#1C1C1E" BorderBrush="#252528" Padding="6,4" CornerRadius="5"/>
                                        </StackPanel>

                                        <StackPanel>
                                            <TextBlock Text="Nombre del Repo" FontSize="9" Foreground="#606060" Margin="0,0,0,3"/>
                                            <TextBox Text="{Binding RepoName, Mode=TwoWay}" PlaceholderText="Repo..." Height="30" FontSize="11" Background="#1C1C1E" BorderBrush="#252528" Padding="6,4" CornerRadius="5"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Privilegio actual calculado -->
                                    <Border Background="#1C1C1E" CornerRadius="5" Padding="8" Margin="0,4,0,4">
                                        <TextBlock Text="{Binding UserRoleText}" FontSize="8" FontWeight="Black" Foreground="White" HorizontalAlignment="Center"/>
                                    </Border>

                                    <Button Command="{Binding AuthenticateGithubCommand}"
                                            Content="CONECTAR NUBE"
                                            Background="White"
                                            Foreground="Black"
                                            Height="35"
                                            CornerRadius="6"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Center"
                                            VerticalContentAlignment="Center"
                                            FontSize="10"
                                            FontWeight="Bold">
                                        <Button.Styles>
                                            <Style Selector="Button:pointerover /template/ ContentPresenter">
                                                <Setter Property="Background" Value="#E0E0E0"/>
                                                <Setter Property="Foreground" Value="Black"/>
                                            </Style>
                                        </Button.Styles>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <!-- SECCIÓN 0.5: HERRAMIENTAS DE CREADOR (EDITORES Y ADMINS A/B) -->
                            <Border Background="#121212"
                                    BorderBrush="#1C1C1E"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="14"
                                    IsVisible="{Binding IsLevelBOrAbove}">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="CREADOR ENGINE" FontSize="8" FontWeight="Black" LetterSpacing="2" Foreground="#FF3B30"/>
                                    
                                    <StackPanel Spacing="8">
                                        <StackPanel>
                                            <TextBlock Text="Título del Wallpaper" FontSize="9" Foreground="#606060" Margin="0,0,0,3"/>
                                            <TextBox Text="{Binding NewWpTitle, Mode=TwoWay}" PlaceholderText="Ej. Brutalism..." Height="30" FontSize="11" Background="#1C1C1E" BorderBrush="#252528" Padding="6,4" CornerRadius="5"/>
                                        </StackPanel>

                                        <StackPanel>
                                            <TextBlock Text="Autor (@crédito)" FontSize="9" Foreground="#606060" Margin="0,0,0,3"/>
                                            <TextBox Text="{Binding NewWpAuthor, Mode=TwoWay}" PlaceholderText="Ej. @creador..." Height="30" FontSize="11" Background="#1C1C1E" BorderBrush="#252528" Padding="6,4" CornerRadius="5"/>
                                        </StackPanel>

                                        <Grid ColumnDefinitions="*,*">
                                            <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                                <TextBlock Text="Categoría" FontSize="9" Foreground="#606060" Margin="0,0,0,3"/>
                                                <ComboBox SelectedItem="{Binding NewWpCategory}" Height="30" HorizontalAlignment="Stretch" Background="#1C1C1E" BorderBrush="#252528" CornerRadius="5" FontSize="10">
                                                    <ComboBoxItem Content="Minimalista"/>
                                                    <ComboBoxItem Content="Arquitectura"/>
                                                    <ComboBoxItem Content="Texturas"/>
                                                    <ComboBoxItem Content="Líneas"/>
                                                </ComboBox>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                                <TextBlock Text="Dispositivo" FontSize="9" Foreground="#606060" Margin="0,0,0,3"/>
                                                <ComboBox SelectedItem="{Binding NewWpDeviceType}" Height="30" HorizontalAlignment="Stretch" Background="#1C1C1E" BorderBrush="#252528" CornerRadius="5" FontSize="10">
                                                    <ComboBoxItem Content="Móvil"/>
                                                    <ComboBoxItem Content="PC"/>
                                                </ComboBox>
                                            </StackPanel>
                                        </Grid>

                                        <StackPanel>
                                            <TextBlock Text="Ruta local o URL web" FontSize="9" Foreground="#606060" Margin="0,0,0,3"/>
                                            <TextBox Text="{Binding NewWpImagePath, Mode=TwoWay}" PlaceholderText="Ruta/URL..." Height="30" FontSize="11" Background="#1C1C1E" BorderBrush="#252528" Padding="6,4" CornerRadius="5"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <Button Command="{Binding UploadNewWallpaperCommand}"
                                            Content="PUBLICAR EN NUBE"
                                            Background="#FF3B30"
                                            Foreground="White"
                                            Height="35"
                                            CornerRadius="6"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Center"
                                            VerticalContentAlignment="Center"
                                            FontSize="10"
                                            FontWeight="Bold">
                                        <Button.Styles>
                                            <Style Selector="Button:pointerover /template/ ContentPresenter">
                                                <Setter Property="Background" Value="#E03028"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </Style>
                                        </Button.Styles>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <!-- SECCIÓN 1: PREFERENCIAS DE DESCARGA -->
                            <Border Background="#121212"
                                    BorderBrush="#1C1C1E"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="14">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="DESCARGAS" FontSize="8" FontWeight="Black" LetterSpacing="2" Foreground="#707070"/>
                                    
                                    <Grid ColumnDefinitions="*,Auto" Margin="0,2,0,2">
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="Resolución" FontSize="12" FontWeight="SemiBold" Foreground="White"/>
                                            <TextBlock Text="Calidad de sólidos." FontSize="9" Foreground="#606060" Margin="0,1,0,0"/>
                                        </StackPanel>
                                        
                                        <ComboBox Grid.Column="1"
                                                  SelectedItem="{Binding DownloadQuality}"
                                                  Width="95"
                                                  Height="28"
                                                  Background="#1C1C1E"
                                                  BorderBrush="#252528"
                                                  CornerRadius="5"
                                                  FontSize="10">
                                            <ComboBoxItem Content="Original"/>
                                            <ComboBoxItem Content="Media"/>
                                            <ComboBoxItem Content="Baja"/>
                                        </ComboBox>
                                    </Grid>

                                    <Separator Height="1" Background="#1C1C1E"/>

                                    <StackPanel Spacing="3" Margin="0,2,0,0">
                                        <TextBlock Text="Carpeta física de guardado" FontSize="11" FontWeight="SemiBold" Foreground="White"/>
                                        <Border Background="#1C1C1E" BorderBrush="#252528" BorderThickness="1" CornerRadius="5" Padding="8,6">
                                            <TextBlock Text="{Binding DownloadPath}" FontSize="9" Foreground="#808080" FontFamily="monospace" TextTrimming="CharacterEllipsis"/>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- SECCIÓN 2: ASPECTO -->
                            <Border Background="#121212"
                                    BorderBrush="#1C1C1E"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="14">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="TEMA DE APLICACIÓN" FontSize="8" FontWeight="Black" LetterSpacing="2" Foreground="#707070"/>
                                    
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="Negro AMOLED" FontSize="12" FontWeight="SemiBold" Foreground="White"/>
                                            <TextBlock Text="Fondo oscuro absoluto." FontSize="9" Foreground="#606060" Margin="0,1,0,0"/>
                                        </StackPanel>
                                        
                                        <ToggleSwitch Grid.Column="1"
                                                      IsChecked="{Binding PureContrastMode, Mode=TwoWay}"
                                                      OnContent=""
                                                      OffContent=""
                                                      MinWidth="0"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- SECCIÓN 3: CACHÉ -->
                            <Border Background="#121212"
                                    BorderBrush="#1C1C1E"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="14">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="MANTENIMIENTO" FontSize="8" FontWeight="Black" LetterSpacing="2" Foreground="#707070"/>
                                    
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="Tamaño de Caché" FontSize="12" FontWeight="SemiBold" Foreground="White"/>
                                            <TextBlock Text="{Binding CacheSizeText}" FontSize="10" Foreground="#808080" Margin="0,1,0,0"/>
                                        </StackPanel>
                                        
                                        <Button Grid.Column="1"
                                                Command="{Binding ClearCacheCommand}"
                                                Content="LIMPIAR"
                                                Background="Transparent"
                                                BorderBrush="#FF3B30"
                                                BorderThickness="1"
                                                Foreground="#FF3B30"
                                                FontSize="9"
                                                FontWeight="Bold"
                                                Padding="10,5"
                                                CornerRadius="5">
                                            <Button.Styles>
                                                <Style Selector="Button:pointerover /template/ ContentPresenter">
                                                    <Setter Property="Background" Value="#1AFF3B30"/>
                                                    <Setter Property="BorderBrush" Value="#FF3B30"/>
                                                    <Setter Property="Foreground" Value="#FF3B30"/>
                                                </Style>
                                            </Button.Styles>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- ================= MODO PRESENTACIÓN AMBIENT SLIDESHOW FULLSCREEN OVERLAY ================= -->
        <Grid Background="#FC08080C"
              IsVisible="{Binding IsSlideshowActive}"
              ZIndex="180"
              Opacity="1">
            <Grid.Transitions>
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.35"/>
                </Transitions>
            </Grid.Transitions>
            
            <!-- Wallpaper de Fondo con Shroud Oscuro -->
            <Image Source="{Binding SlideshowCurrentWp.ImageBitmap}"
                   Stretch="UniformToFill"
                   Opacity="0.45"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"/>

            <!-- Sombreado Brutalista inferior y superior para controles -->
            <Border VerticalAlignment="Bottom" Height="140">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#00000000" Offset="0"/>
                        <GradientStop Color="#FC08080C" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <!-- CONTENIDO CENTRAL: CRONÓMETRO SWISS POMODORO FOCUS -->
            <Grid VerticalAlignment="Center" HorizontalAlignment="Center" RowDefinitions="Auto,Auto,Auto" IsVisible="{Binding IsFocusTimerActive}">
                <!-- Modo actual: CONCENTRACIÓN (Blanco) o DESCANSO (Rojo) -->
                <Border Grid.Row="0"
                        Background="#1A121214"
                        BorderBrush="#33FFFFFF"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="10,4"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="⚙ STATUS:" FontSize="8" FontWeight="Black" LetterSpacing="1" Foreground="#8E8E93" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding FocusTimerMode}" FontSize="8.5" FontWeight="Black" LetterSpacing="1.5" Foreground="White" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Gran Reloj Monospace -->
                <TextBlock Grid.Row="1"
                           Text="{Binding FocusTimerText}"
                           FontSize="96"
                           FontWeight="Light"
                           Foreground="White"
                           LetterSpacing="-2"
                           FontFamily="monospace, Courier New, Inter, -apple-system, sans-serif"
                           HorizontalAlignment="Center"/>

                <!-- Minimalist progress bar -->
                <ProgressBar Grid.Row="2"
                             Value="{Binding FocusTimerProgressPercent}"
                             Minimum="0"
                             Maximum="100"
                             Height="2"
                             Width="200"
                             Background="#33FFFFFF"
                             Foreground="White"
                             HorizontalAlignment="Center"
                             Margin="0,16,0,0"/>
            </Grid>

            <!-- BARRA DE CONTROLES INFERIOR BRUTALISTA -->
            <Border VerticalAlignment="Bottom"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,40"
                    Background="#EE0E0E12"
                    BorderBrush="#252528"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="14,10"
                    Width="480">
                <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto,Auto,*">
                    <!-- Título del Wallpaper actual -->
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="8,0,0,0">
                        <TextBlock Text="{Binding SlideshowCurrentWp.Title}" FontSize="11" FontWeight="Bold" Foreground="White" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding SlideshowCurrentWp.Author}" FontSize="8" Foreground="#707070" Margin="0,1,0,0"/>
                    </StackPanel>

                    <!-- Botones de Control del Temporizador Focus -->
                    <ToggleButton Grid.Column="1"
                                  IsChecked="{Binding IsFocusTimerActive, Mode=TwoWay}"
                                  Width="34"
                                  Height="34"
                                  CornerRadius="6"
                                  Margin="0,0,6,0"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  ToolTip.Tip="MOSTRAR/OCULTAR TEMPORIZADOR FOCUS">
                        <ToggleButton.Styles>
                            <Style Selector="ToggleButton:checked TextBlock">
                                <Setter Property="Foreground" Value="White"/>
                            </Style>
                            <Style Selector="ToggleButton:not(:checked) TextBlock">
                                <Setter Property="Foreground" Value="#606060"/>
                            </Style>
                        </ToggleButton.Styles>
                        <TextBlock Text="⏱" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </ToggleButton>

                    <!-- Iniciar/Pausar Temporizador Pomodoro -->
                    <ToggleButton Grid.Column="2"
                                  IsVisible="{Binding IsFocusTimerActive}"
                                  IsChecked="{Binding IsFocusTimerRunning, Mode=TwoWay}"
                                  Width="34"
                                  Height="34"
                                  CornerRadius="6"
                                  Margin="0,0,6,0"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  ToolTip.Tip="INICIAR/PAUSAR FOCUS TIMER">
                        <ToggleButton.Styles>
                            <Style Selector="ToggleButton:checked TextBlock">
                                <Setter Property="Text" Value="⏸"/>
                                <Setter Property="Foreground" Value="#34C759"/>
                            </Style>
                            <Style Selector="ToggleButton:not(:checked) TextBlock">
                                <Setter Property="Text" Value="▶"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Style>
                        </ToggleButton.Styles>
                        <TextBlock Text="▶" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </ToggleButton>

                    <!-- Reset del Temporizador Pomodoro -->
                    <Button Grid.Column="3"
                            IsVisible="{Binding IsFocusTimerActive}"
                            Command="{Binding ResetFocusTimerCommand}"
                            Width="34"
                            Height="34"
                            CornerRadius="6"
                            Margin="0,0,16,0"
                            Background="Transparent"
                            BorderThickness="0"
                            ToolTip.Tip="REINICIAR FOCUS TIMER">
                        <TextBlock Text="↺" FontSize="14" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>

                    <Separator Grid.Column="4" Width="1" Height="20" Background="#2C2C2E" Margin="0,0,16,0"/>

                    <!-- Control del Slideshow manual -->
                    <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="6">
                        <!-- Anterior -->
                        <Button Command="{Binding PrevSlideshowCommand}"
                                Width="34"
                                Height="34"
                                CornerRadius="6"
                                Background="Transparent"
                                BorderThickness="0"
                                ToolTip.Tip="WALLPAPER ANTERIOR">
                            <TextBlock Text="◀" FontSize="10" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                        <!-- Reproducir/Pausar Bucle -->
                        <ToggleButton IsChecked="{Binding IsSlideshowPlaying, Mode=TwoWay}"
                                      Width="34"
                                      Height="34"
                                      CornerRadius="6"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      ToolTip.Tip="REPRODUCIR/PAUSAR SLIDESHOW">
                            <ToggleButton.Styles>
                                <Style Selector="ToggleButton:checked TextBlock">
                                    <Setter Property="Text" Value="⏸"/>
                                </Style>
                                <Style Selector="ToggleButton:not(:checked) TextBlock">
                                    <Setter Property="Text" Value="▶"/>
                                </Style>
                            </ToggleButton.Styles>
                            <TextBlock Text="⏸" FontSize="11" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </ToggleButton>
                        <!-- Siguiente -->
                        <Button Command="{Binding NextSlideshowCommand}"
                                Width="34"
                                Height="34"
                                CornerRadius="6"
                                Background="Transparent"
                                BorderThickness="0"
                                ToolTip.Tip="WALLPAPER SIGUIENTE">
                            <TextBlock Text="▶▶" FontSize="8" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </StackPanel>

                    <!-- Salir de la Presentación -->
                    <Button Grid.Column="6"
                            Command="{Binding ToggleSlideshowCommand}"
                            Width="34"
                            Height="34"
                            CornerRadius="6"
                            Margin="16,0,0,0"
                            Background="#EEFF3B30"
                            BorderBrush="#FF3B30"
                            BorderThickness="1"
                            ToolTip.Tip="CERRAR PRESENTACIÓN">
                        <TextBlock Text="×" FontSize="15" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                </Grid>
            </Border>
        </Grid>

        <!-- BANNER DE NOTIFICACIONES TOAST MINIMALISTA -->
        <Border VerticalAlignment="Top"
                HorizontalAlignment="Center"
                Margin="0,60,0,0"
                Background="#121212"
                BorderBrush="White"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16,8"
                ZIndex="200"
                IsVisible="{Binding IsToastVisible}"
                BoxShadow="0 4 15 0 #90000000">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock Text="⚡" Foreground="White" FontSize="13"/>
                <TextBlock Text="{Binding ToastMessage}" Foreground="White" FontSize="11" FontWeight="Bold" LetterSpacing="0.5"/>
            </StackPanel>
        </Border>
    </Grid>

</Window>