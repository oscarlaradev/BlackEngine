<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:vm="using:BlackEngine.ViewModels"
        xmlns:controls="using:BlackEngine.Controls"
        mc:Ignorable="d"
        x:Class="BlackEngine.MainWindow"
        x:CompileBindings="False"
        x:Name="RootWindow"
        Width="450"
        Height="800"
        MinWidth="380"
        MinHeight="650"
        Title="BlackEngine"
        Icon="/Assets/icon.png"
        Background="{Binding WindowBackgroundString}"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="-1">


    <Window.DataContext>
        <vm:MainWindowViewModel/>
    </Window.DataContext>

    <Grid>
        <!-- CONTENIDO PRINCIPAL -->
        <Grid RowDefinitions="Auto,*" Margin="20,50,20,15">

            <!-- CABECERA EN DOS FILAS: FILA 0: LOGO Y AJUSTES | FILA 1: TABS ALINEADOS AL CENTRO -->
            <Grid Grid.Row="0" RowDefinitions="Auto,Auto" Margin="0,0,0,22">
                
                <!-- FILA 0: LOGO Y AJUSTES -->
                <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                    
                    <!-- LOGO BRUTALISTA DE BLACKENGINE -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <!-- Icono de doble rombo rotado minimalista superpuesto -->
                        <Grid Width="16" Height="16" VerticalAlignment="Center">
                            <!-- Rombo de acento oscuro de fondo -->
                            <Border Width="8" Height="8" BorderBrush="#444446" BorderThickness="1" CornerRadius="1.5" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                <Border.RenderTransform>
                                    <RotateTransform Angle="45"/>
                                </Border.RenderTransform>
                            </Border>
                            <!-- Rombo de luz frontal -->
                            <Border Width="8" Height="8" Background="White" BorderBrush="White" BorderThickness="1" CornerRadius="1.5" HorizontalAlignment="Left" VerticalAlignment="Top">
                                <Border.RenderTransform>
                                    <RotateTransform Angle="45"/>
                                </Border.RenderTransform>
                            </Border>
                        </Grid>
                        <TextBlock Text="BlackEngine" FontSize="12.5" FontWeight="Black" LetterSpacing="0.8" Foreground="White" FontFamily="Inter, -apple-system, BlinkMacSystemFont, sans-serif" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- ESPACIADOR -->
                    <Grid Grid.Column="1"/>

                    <!-- BOTÓN AJUSTES TIPOGRÁFICO PREMIUM (Slide Trigger) -->
                    <Button Grid.Column="2"
                            Command="{Binding ToggleSettingsCommand}"
                            Background="Transparent"
                            BorderBrush="#1C1C1E"
                            BorderThickness="1"
                            Width="30"
                            Height="30"
                            CornerRadius="6"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                        <PathIcon Data="M19.14,12.94c0.04-0.3,0.06-0.61,0.06-0.94c0-0.32-0.02-0.64-0.06-0.94l2.03-1.58c0.18-0.14,0.23-0.41,0.12-0.61 l-1.92-3.32c-0.12-0.22-0.37-0.29-0.59-0.22l-2.39,0.96c-0.5-0.38-1.03-0.7-1.62-0.94L14.4,2.81c-0.04-0.24-0.24-0.41-0.48-0.41 h-3.84c-0.24,0-0.43,0.17-0.47,0.41L9.25,5.35C8.66,5.59,8.12,5.92,7.63,6.29L5.24,5.33c-0.22-0.08-0.47,0-0.59,0.22L2.73,8.87 C2.62,9.08,2.66,9.34,2.86,9.48l2.03,1.58C4.84,11.36,4.8,11.69,4.8,12s0.02,0.64,0.06,0.94l-2.03,1.58 c-0.18,0.14-0.23,0.41-0.12,0.61l1.92,3.32c0.12,0.22,0.37,0.29,0.59,0.22l2.39-0.96c0.5,0.38,1.03,0.7,1.62,0.94l0.36,2.54 c0.05,0.24,0.24,0.41,0.48,0.41h3.84c0.24,0,0.43-0.17,0.47-0.41l0.36-2.54c0.59-0.24,1.13-0.56,1.62-0.94l2.39,0.96 c0.22,0.08,0.47,0,0.59-0.22l1.92-3.32c0.12-0.22,0.07-0.49-0.12-0.61L19.14,12.94z M12,15.6c-1.98,0-3.6-1.62-3.6-3.6 s1.62-3.6,3.6-3.6s3.6,1.62,3.6,3.6S13.98,15.6,12,15.6z" Width="14" Height="14" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                </Grid>
                
                <!-- FILA 1: PESTAÑAS (TABS) CENTRADAS MÁS ABAJO -->
                <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <ListBox ItemsSource="{Binding Tabs}"
                         SelectedItem="{Binding SelectedTab, Mode=TwoWay}"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="0"
                         HorizontalAlignment="Center"
                         Margin="0,18,0,0">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="25"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                            <Setter Property="Padding" Value="0,4"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="#505050"/>
                            <Setter Property="FontSize" Value="9.5"/>
                            <Setter Property="FontWeight" Value="Black"/>
                            <Setter Property="LetterSpacing" Value="2"/>
                            <Setter Property="Transitions">
                                <Transitions>
                                    <BrushTransition Property="Foreground" Duration="0:0:0.12"/>
                                </Transitions>
                            </Setter>
                        </Style>
                        <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="#909090"/>
                        </Style>
                        <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Style>
                        <Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Style>
                    </ListBox.Styles>
                </ListBox>
                </ScrollViewer>
            </Grid>

            <!-- VISTA DE PANELES MULTICAPA -->
            <Grid Grid.Row="1">

                <!-- ================= VISTA 1: GALERÍA ================= -->
                <Grid RowDefinitions="Auto,*" IsVisible="{Binding IsGalleryTabVisible}">
                    
                    <!-- BUSCADOR MINIMALISTA + FILTRO PREMIUM POPUP + SPOTLIGHT DIRECT SHORTCUT -->
                    <Border Grid.Row="0"
                            Background="#09090B"
                            BorderBrush="#18181B"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12,3"
                            Margin="0,0,0,12">
                        <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto">
                                <PathIcon Data="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z" Width="10" Height="10" Foreground="#52525B" Margin="0,0,6,0"/>
                                <TextBlock Grid.Column="0"
                                           Text="SEARCH"
                                       Foreground="#52525B"
                                       FontSize="8"
                                       FontWeight="Black"
                                       LetterSpacing="1.5"
                                       VerticalAlignment="Center"
                                       Margin="0,0,14,0"
                                       FontFamily="Inter, -apple-system, BlinkMacSystemFont, Segoe UI, Roboto, sans-serif"/>
                            <!-- Contador técnico de catálogo -->
                            <Border Grid.Column="1"
                                    Background="#18181B"
                                    BorderBrush="#27272A"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="6,2"
                                    Margin="0,0,14,0"
                                    VerticalAlignment="Center"
                                    IsVisible="{Binding Wallpapers.Count}">
                                <TextBlock Text="{Binding CatalogCountText}" FontSize="7" FontWeight="Black" Foreground="#A1A1AA" FontFamily="monospace"/>
                            </Border>
                            <TextBox Grid.Column="2"
                                     PlaceholderText="Buscar obras, autores o categorías..."
                                     Text="{Binding SearchText, Mode=TwoWay}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="White"
                                     FontSize="12"
                                     Padding="0,1,0,0"
                                     VerticalAlignment="Center"
                                     VerticalContentAlignment="Center"
                                     FontFamily="Inter, -apple-system, BlinkMacSystemFont, Segoe UI, Roboto, sans-serif"/>
                            
                            <!-- BOTÓN DE FILTRO FLYOUT (DESPLEGABLE MINIMALISTA Y ESPECTACULAR) -->
                            <Button Grid.Column="3"
                                    Background="Transparent"
                                    BorderBrush="Transparent"
                                    BorderThickness="0"
                                    Width="32"
                                    Height="32"
                                    CornerRadius="6"
                                    VerticalAlignment="Center"
                                    Margin="0,0,4,0">
                                <PathIcon Data="M3 5h18v2H3V5zm4 7h10v2H7v-2zm3 7h4v2h-4v-2z" Width="12" Height="12" Foreground="#A1A1AA" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Button.Flyout>
                                    <Flyout Placement="BottomEdgeAlignedRight" ShowMode="Standard">
                                        <Border Background="#0C0C0E"
                                                BorderBrush="#1C1C1E"
                                                BorderThickness="1"
                                                CornerRadius="10"
                                                Padding="14"
                                                Width="240"
                                                BoxShadow="0 10 30 0 #A0000000">
                                            <StackPanel Spacing="14">
                                                <!-- DISPOSITIVO -->
                                                <StackPanel Spacing="6">
                                                    <TextBlock Text="FILTRAR POR DISPOSITIVO" FontSize="7.5" FontWeight="Black" LetterSpacing="1.5" Foreground="#52525B"/>
                                                    <ListBox ItemsSource="{Binding DeviceFilters}"
                                                             SelectedItem="{Binding SelectedDeviceFilter, Mode=TwoWay}"
                                                             Background="Transparent"
                                                             BorderThickness="0"
                                                             Padding="0">
                                                        <ListBox.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <UniformGrid Columns="3"/>
                                                            </ItemsPanelTemplate>
                                                        </ListBox.ItemsPanel>
                                                        <ListBox.Styles>
                                                            <Style Selector="ListBoxItem">
                                                                <Setter Property="Padding" Value="0,6"/>
                                                                <Setter Property="Background" Value="#18181B"/>
                                                                <Setter Property="Foreground" Value="#71717A"/>
                                                                <Setter Property="FontSize" Value="8.5"/>
                                                                <Setter Property="FontWeight" Value="Bold"/>
                                                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                                                                <Setter Property="CornerRadius" Value="4"/>
                                                                <Setter Property="BorderThickness" Value="1"/>
                                                                <Setter Property="BorderBrush" Value="#27272A"/>
                                                                <Setter Property="Margin" Value="2"/>
                                                            </Style>
                                                            <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                                                                <Setter Property="Background" Value="#27272A"/>
                                                                <Setter Property="Foreground" Value="White"/>
                                                            </Style>
                                                            <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                                                                <Setter Property="Background" Value="White"/>
                                                                <Setter Property="Foreground" Value="Black"/>
                                                                <Setter Property="BorderBrush" Value="White"/>
                                                            </Style>
                                                        </ListBox.Styles>
                                                    </ListBox>
                                                </StackPanel>

                                                <!-- DIVIDER -->
                                                <Border Height="1" Background="#1C1C1E"/>

                                                <!-- CATEGORÍA -->
                                                <StackPanel Spacing="6">
                                                    <TextBlock Text="FILTRAR POR ESTILO / CATEGORÍA" FontSize="7.5" FontWeight="Black" LetterSpacing="1.5" Foreground="#52525B"/>
                                                    <ListBox ItemsSource="{Binding Categories}"
                                                             SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                                                             Background="Transparent"
                                                             BorderThickness="0"
                                                             Padding="0">
                                                        <ListBox.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <WrapPanel ItemWidth="68" ItemHeight="26"/>
                                                            </ItemsPanelTemplate>
                                                        </ListBox.ItemsPanel>
                                                        <ListBox.Styles>
                                                            <Style Selector="ListBoxItem">
                                                                <Setter Property="Padding" Value="2,4"/>
                                                                <Setter Property="Background" Value="#18181B"/>
                                                                <Setter Property="Foreground" Value="#71717A"/>
                                                                <Setter Property="FontSize" Value="8"/>
                                                                <Setter Property="FontWeight" Value="Bold"/>
                                                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                                                                <Setter Property="CornerRadius" Value="4"/>
                                                                <Setter Property="BorderThickness" Value="1"/>
                                                                <Setter Property="BorderBrush" Value="#27272A"/>
                                                                <Setter Property="Margin" Value="2"/>
                                                            </Style>
                                                            <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                                                                <Setter Property="Background" Value="#27272A"/>
                                                                <Setter Property="Foreground" Value="White"/>
                                                            </Style>
                                                            <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                                                                <Setter Property="Background" Value="White"/>
                                                                <Setter Property="Foreground" Value="Black"/>
                                                                <Setter Property="BorderBrush" Value="White"/>
                                                            </Style>
                                                        </ListBox.Styles>
                                                    </ListBox>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                            
                            <!-- BOTÓN MODO PRESENTACIÓN AMBIENT SLIDESHOW -->
                            <Button Grid.Column="4"
                                    Command="{Binding ToggleSlideshowCommand}"
                                    Background="Transparent"
                                    BorderBrush="Transparent"
                                    BorderThickness="0"
                                    Width="32"
                                    Height="32"
                                    CornerRadius="6"
                                    VerticalAlignment="Center"
                                    Margin="0,0,4,0"
                                    ToolTip.Tip="INICIAR PRESENTACIÓN AMBIENTAL">
                                <PathIcon Data="M21 3H3c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h5v1c0 .55.45 1 1 1h6c.55 0 1-.45 1-1v-1h5c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 14H3V5h18v12z" Width="12" Height="12" Foreground="#A1A1AA" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>

                            <Button Grid.Column="5"
                                    Command="{Binding ToggleSpotlightCommand}"
                                    Background="#18181B"
                                    BorderBrush="#27272A"
                                    BorderThickness="1"
                                    Padding="8,4"
                                    CornerRadius="4"
                                    VerticalAlignment="Center">
                                <TextBlock Text="⌘K" FontSize="8" FontWeight="Black" Foreground="White"/>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- ESTADO VACÍO INICIAL MINIMALISTA -->
                    <StackPanel Grid.Row="1"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Spacing="16"
                                IsVisible="{Binding !Wallpapers.Count}"
                                Margin="0,80,0,80">
                        <Grid Width="24" Height="24" HorizontalAlignment="Center">
                            <Ellipse Width="8" Height="8" Fill="#71717A" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Ellipse Width="24" Height="24" Stroke="#27272A" StrokeThickness="1" StrokeDashArray="3,3"/>
                        </Grid>
                        <StackPanel Spacing="4">
                            <TextBlock Text="GALERÍA SIN CONTENIDO" FontSize="9" FontWeight="Black" LetterSpacing="2" Foreground="#8A8A8E" HorizontalAlignment="Center" FontFamily="Inter, -apple-system, sans-serif"/>
                            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                <TextBlock Text="Conecta tu GITHUB CLOUD ENGINE en el menú de ajustes"
                                           Foreground="#8E8E93"
                                           FontSize="13"
                                           FontWeight="Medium"/>
                                <PathIcon Data="M19.14,12.94c0.04-0.3,0.06-0.61,0.06-0.94c0-0.32-0.02-0.64-0.06-0.94l2.03-1.58c0.18-0.14,0.23-0.41,0.12-0.61 l-1.92-3.32c-0.12-0.22-0.37-0.29-0.59-0.22l-2.39,0.96c-0.5-0.38-1.03-0.7-1.62-0.94L14.4,2.81c-0.04-0.24-0.24-0.41-0.48-0.41 h-3.84c-0.24,0-0.43,0.17-0.47,0.41L9.25,5.35C8.66,5.59,8.12,5.92,7.63,6.29L5.24,5.33c-0.22-0.08-0.47,0-0.59,0.22L2.73,8.87 C2.62,9.08,2.66,9.34,2.86,9.48l2.03,1.58C4.84,11.36,4.8,11.69,4.8,12s0.02,0.64,0.06,0.94l-2.03,1.58 c-0.18,0.14-0.23,0.41-0.12,0.61l1.92,3.32c0.12,0.22,0.37,0.29,0.59,0.22l2.39-0.96c0.5,0.38,1.03,0.7,1.62,0.94l0.36,2.54 c0.05,0.24,0.24,0.41,0.48,0.41h3.84c0.24,0,0.43-0.17,0.47-0.41l0.36-2.54c0.59-0.24,1.13-0.56,1.62-0.94l2.39,0.96 c0.22,0.08,0.47,0,0.59-0.22l1.92-3.32c0.12-0.22,0.07-0.49-0.12-0.61L19.14,12.94z M12,15.6c-1.98,0-3.6-1.62-3.6-3.6 s1.62-3.6,3.6-3.6s3.6,1.62,3.6,3.6S13.98,15.6,12,15.6z" Width="14" Height="14" Foreground="#8E8E93" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <!-- GRILLA DE IMÁGENES -->
                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding Wallpapers}"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="0"
                             IsVisible="{Binding Wallpapers.Count}">
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="Background" Value="Transparent"/>
                            </Style>
                            <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                                <Setter Property="Background" Value="Transparent"/>
                            </Style>
                            <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                                <Setter Property="Background" Value="Transparent"/>
                            </Style>
                            <Style Selector="ListBoxItem:pointerover Border.WpCard">
                                <Setter Property="BorderBrush" Value="#444449"/>
                            </Style>
                        </ListBox.Styles>
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel ItemWidth="240" Margin="0" HorizontalAlignment="Center"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <!-- Premium Glassmorphic Card -->
                                <Border Classes="WpCard"
                                        Height="360"
                                        Margin="10"
                                        CornerRadius="18"
                                        ClipToBounds="True"
                                        Background="#101014"
                                        BorderBrush="#1C1C1E"
                                        BorderThickness="1"
                                        BoxShadow="0 15 40 -10 #A0000000">
                                    <Border.Transitions>
                                        <Transitions>
                                            <ThicknessTransition Property="Margin" Duration="0:0:0.2"/>
                                            <BrushTransition Property="BorderBrush" Duration="0:0:0.2"/>
                                        </Transitions>
                                    </Border.Transitions>
                                    
                                    <Grid>
                                        <!-- CLIC EN IMAGEN (Main Wallpaper) -->
                                        <Button Command="{Binding #RootWindow.DataContext.SelectWallpaperCommand}"
                                                CommandParameter="{Binding}"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Padding="0"
                                                HorizontalAlignment="Stretch"
                                                VerticalAlignment="Stretch"
                                                HorizontalContentAlignment="Stretch"
                                                VerticalContentAlignment="Stretch">
                                            <Grid>
                                                <Image Source="{Binding ImageBitmap}"
                                                       Stretch="UniformToFill"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                                
                                                <!-- Premium Shadow Gradient (Bottom) -->
                                                <Border VerticalAlignment="Bottom" Height="140">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                            <GradientStop Color="#00000000" Offset="0"/>
                                                            <GradientStop Color="#EE000000" Offset="0.8"/>
                                                            <GradientStop Color="#FF000000" Offset="1"/>
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                </Border>
                                            </Grid>
                                        </Button>

                                        <!-- ACTION BAR (Top) - Glassmorphism -->
                                        <Grid VerticalAlignment="Top" Margin="12" ColumnDefinitions="Auto,*,Auto">
                                            
                                            <!-- Delete (Trash) - Minimalist Icon -->
                                            <Button Grid.Column="0"
                                                    Command="{Binding #RootWindow.DataContext.DeleteWallpaperCommand}"
                                                    CommandParameter="{Binding}"
                                                    IsVisible="{Binding #RootWindow.DataContext.IsLevelA}"
                                                    Width="32" Height="32" CornerRadius="16"
                                                    Background="#801C1C1E" BorderBrush="#30FFFFFF" BorderThickness="1"
                                                    ToolTip.Tip="Eliminar de la nube">
                                                <PathIcon Data="M19 6L5 6M10 11V17M14 11V17M18 6V20C18 21.1 17.1 22 16 22H8C6.9 22 6 21.1 6 20V6M15 6V4C15 2.9 14.1 2 13 2H11C9.9 2 9 2.9 9 4V6" 
                                                          Foreground="#FF453A" Width="14" Height="14"/>
                                                <Button.Styles>
                                                    <Style Selector="Button:pointerover">
                                                        <Setter Property="Background" Value="#CCFF453A"/>
                                                    </Style>
                                                    <Style Selector="Button:pointerover PathIcon">
                                                        <Setter Property="Foreground" Value="White"/>
                                                    </Style>
                                                </Button.Styles>
                                            </Button>
                                            
                                            <!-- Favorite (Heart) - Minimalist Icon -->
                                            <ToggleButton Grid.Column="2"
                                                          IsChecked="{Binding IsFavorite, Mode=TwoWay}"
                                                          Command="{Binding #RootWindow.DataContext.ToggleFavoriteCommand}"
                                                          CommandParameter="{Binding}"
                                                          Width="32" Height="32" CornerRadius="16"
                                                          Background="#801C1C1E" BorderBrush="#30FFFFFF" BorderThickness="1">
                                                <ToggleButton.Styles>
                                                    <Style Selector="ToggleButton:checked">
                                                        <Setter Property="Background" Value="#FFFF453A"/>
                                                        <Setter Property="BorderBrush" Value="#FFFF453A"/>
                                                    </Style>
                                                    <Style Selector="ToggleButton:checked PathIcon">
                                                        <Setter Property="Foreground" Value="White"/>
                                                    </Style>
                                                </ToggleButton.Styles>
                                                <!-- SVG Path for Heart Outline (Minimalist) -->
                                                <PathIcon Data="M16.5 3c-1.74 0-3.41.81-4.5 2.09C10.91 3.81 9.24 3 7.5 3 4.42 3 2 5.42 2 8.5c0 3.78 3.4 6.86 8.55 11.54L12 21.35l1.45-1.32C18.6 15.36 22 12.28 22 8.5 22 5.42 19.58 3 16.5 3zm-4.4 15.55l-.1.1-.1-.1C7.14 14.24 4 11.39 4 8.5 4 6.5 5.5 5 7.5 5c1.54 0 3.04.99 3.57 2.36h1.87C13.46 5.99 14.96 5 16.5 5c2 0 3.5 1.5 3.5 3.5 0 2.89-3.14 5.74-7.9 10.05z" 
                                                          Foreground="#EBEBF5" Width="14" Height="14"/>
                                            </ToggleButton>
                                        </Grid>

                                        <!-- BOTTOM METADATA -->
                                        <Grid VerticalAlignment="Bottom" Margin="14" ColumnDefinitions="*,Auto" IsHitTestVisible="False">
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}"
                                                           FontSize="14"
                                                           FontWeight="SemiBold"
                                                           Foreground="White"
                                                           LetterSpacing="0.3"
                                                           TextTrimming="CharacterEllipsis"
                                                           FontFamily="Inter, -apple-system, BlinkMacSystemFont, Segoe UI, Roboto, sans-serif"/>
                                                <TextBlock Text="{Binding Author}"
                                                           FontSize="11"
                                                           Foreground="#A0A0A5"
                                                           FontWeight="Regular"
                                                           Margin="0,2,0,0"/>
                                            </StackPanel>
                                            
                                            <!-- TAGS -->
                                            <StackPanel Grid.Column="1" Orientation="Vertical" Spacing="4" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                <Border Padding="6,2" Background="#801C1C1E" BorderBrush="#30FFFFFF" BorderThickness="1" CornerRadius="4">
                                                    <TextBlock Text="{Binding DeviceType}" FontSize="8" FontWeight="SemiBold" Foreground="#EBEBF5"/>
                                                </Border>
                                                <Border Padding="6,2" Background="#80007AFF" BorderBrush="#30FFFFFF" BorderThickness="1" CornerRadius="4">
                                                    <TextBlock Text="{Binding Category}" FontSize="8" FontWeight="SemiBold" Foreground="White"/>
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>

                <!-- ================= VISTA 2: COLOR WHEEL 3D ================= -->
                <Grid RowDefinitions="Auto,*,Auto" IsVisible="{Binding IsColorTabVisible}" Margin="10,0,10,0">
                    
                    <!-- TEXTO DE INSTRUCCIONES -->
                    <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,5,0,0">
                        <TextBlock Text="COLOR SPHERE 3D"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   LetterSpacing="3"
                                   Foreground="White"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Arrastra para rotar la esfera. Clica una partícula para seleccionar."
                                   FontSize="11"
                                   Foreground="#707070"
                                   Margin="0,4,0,0"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>

                    <!-- CONTENEDOR CENTRAL DE LA RUEDA 3D CON BRÚJULA TÉCNICA (Súper Responsivo) -->
                    <Border Grid.Row="1"
                            VerticalAlignment="Stretch"
                            HorizontalAlignment="Stretch"
                            Background="Transparent"
                            Margin="0,10,0,10">
                        <Viewbox Stretch="Uniform" MaxWidth="320" MaxHeight="320" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Grid Width="330" Height="330">
                                <!-- Concentric thin circles -->
                                <Ellipse Width="330" Height="330" Stroke="#151518" StrokeThickness="1" StrokeDashArray="3,3"/>
                                <Ellipse Width="260" Height="260" Stroke="#151518" StrokeThickness="1" StrokeDashArray="3,3"/>
                                <Ellipse Width="190" Height="190" Stroke="#151518" StrokeThickness="1" StrokeDashArray="3,3"/>
                                <Ellipse Width="120" Height="120" Stroke="#151518" StrokeThickness="1" StrokeDashArray="3,3"/>
                                
                                <!-- Technical Crosshair axes -->
                                <Line StartPoint="165,0" EndPoint="165,330" Stroke="#151518" StrokeThickness="1" StrokeDashArray="4,4"/>
                                <Line StartPoint="0,165" EndPoint="330,165" Stroke="#151518" StrokeThickness="1" StrokeDashArray="4,4"/>
                                
                                <!-- Precise Angle HUD Labels -->
                                <TextBlock Text="N  0°" FontSize="6.5" FontWeight="Black" Foreground="#444449" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,5,0,0" FontFamily="monospace"/>
                                <TextBlock Text="E  90°" FontSize="6.5" FontWeight="Black" Foreground="#444449" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,5,0" FontFamily="monospace"/>
                                <TextBlock Text="S  180°" FontSize="6.5" FontWeight="Black" Foreground="#444449" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,5" FontFamily="monospace"/>
                                <TextBlock Text="W  270°" FontSize="6.5" FontWeight="Black" Foreground="#444449" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="5,0,0,0" FontFamily="monospace"/>
                                
                                <!-- Actual 3D sphere component -->
                                <controls:ColorWheelControl SelectedColor="{Binding SelectedSolidColor, Mode=TwoWay}"
                                                           HorizontalAlignment="Stretch"
                                                           VerticalAlignment="Stretch"/>
                            </Grid>
                        </Viewbox>
                    </Border>

                    <!-- DECK DE CALIBRACIÓN ULTRA PREMIUM (MEDIO CÍRCULO / PANEL ESFEROIDAL BRUTALISTA) -->
                    <Border Grid.Row="2"
                            Background="#0A0A0C"
                            BorderBrush="#1C1C1F"
                            BorderThickness="1,1,1,0"
                            CornerRadius="24,24,0,0"
                            Padding="18,16,18,16"
                            Margin="-10,0,-10,0">
                        <StackPanel Spacing="14">
                            
                            <!-- Sección 1: Calibrador de Medio Círculo (sRGB Arc Dial) -->
                            <Grid HorizontalAlignment="Center" Height="52" Width="120" Margin="0,0,0,6">
                                <!-- Concentric dashed calibration arches -->
                                <Path Data="M 5,45 A 50,50 0 0,1 115,45" Stroke="#161619" StrokeThickness="1.5" StrokeDashArray="3,3" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Path Data="M 15,45 A 40,40 0 0,1 105,45" Stroke="#202024" StrokeThickness="1" StrokeDashArray="2,2" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Path Data="M 25,45 A 30,30 0 0,1 95,45" Stroke="{Binding SelectedSolidColorBrush}" StrokeThickness="0.75" Opacity="0.5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                
                                <!-- Dynamic Glowing Core (Medio Círculo / Esfera Principal) -->
                                <Border Width="24" Height="24" CornerRadius="12" 
                                        Background="{Binding SelectedSolidColorBrush}" 
                                        BorderBrush="#2A2A2F" BorderThickness="1"
                                        HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,6">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="12" Color="{Binding SelectedSolidColor}" Opacity="0.4"/>
                                    </Border.Effect>
                                </Border>

                                <!-- Complementary Miniature Bubble (Acento del Diseñador) -->
                                <Border Width="10" Height="10" CornerRadius="5"
                                        Background="{Binding ComplementarySolidColorBrush}"
                                        BorderBrush="#1C1C1F" BorderThickness="1"
                                        HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,25,6"
                                        ToolTip.Tip="COLOR COMPLEMENTARIO ARMÓNICO">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="4" Color="{Binding SelectedSolidColor}" Opacity="0.4"/>
                                    </Border.Effect>
                                </Border>
                                
                                <!-- Tech Specs & Calibration Scale -->
                                <TextBlock Text="0%" FontSize="5.5" FontWeight="Bold" Foreground="#3F3F46" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="4,0,0,4" FontFamily="monospace"/>
                                <TextBlock Text="100%" FontSize="5.5" FontWeight="Bold" Foreground="#3F3F46" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,4,4" FontFamily="monospace"/>
                                <TextBlock Text="sRGB ARC" FontSize="5.5" FontWeight="Black" LetterSpacing="1" Foreground="#52525B" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,1,0,0" FontFamily="monospace"/>
                            </Grid>

                            <!-- Sección 2: Cabecera del Panel (HEX Input y Dynamic Contrast) -->
                            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                <!-- Dynamic Contrast Checker (WCAG Standard) -->
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="ANALIZADOR DE CONTRASTE WCAG" FontSize="6.5" FontWeight="Black" LetterSpacing="1.2" Foreground="#52525B"/>
                                    <TextBlock Text="{Binding ContrastRatioText}" FontSize="8.5" FontWeight="Bold" Foreground="#A1A1AA" FontFamily="monospace" Margin="0,1,0,0"/>
                                </StackPanel>

                                <!-- INPUT HEXADECIMAL DEL DISEÑADOR (Interactive Hex Input) -->
                                <Border Grid.Column="1" 
                                        Background="#111113" 
                                        BorderBrush="#252528"
                                        BorderThickness="1"
                                        CornerRadius="6" 
                                        Padding="8,4" 
                                        VerticalAlignment="Center" 
                                        Width="105">
                                    <Grid ColumnDefinitions="Auto,*">
                                        <TextBlock Grid.Column="0" Text="#" FontSize="10.5" FontWeight="Black" Foreground="#52525B" VerticalAlignment="Center" Margin="0,0,3,0"/>
                                        <TextBox Grid.Column="1"
                                                 Text="{Binding CustomHexInput, Mode=TwoWay}"
                                                 PlaceholderText="FFFFFF"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 Foreground="White"
                                                 FontSize="10"
                                                 FontFamily="monospace"
                                                 Padding="0"
                                                 VerticalAlignment="Center"
                                                 VerticalContentAlignment="Center"
                                                 Height="16"/>
                                    </Grid>
                                </Border>
                            </Grid>

                            <!-- Divider Fino -->
                            <Border Height="1" Background="#161619"/>

                            <!-- Sección 3: Ajuste de Brillo HSL y Ruido Táctil en una Grilla -->
                            <Grid RowDefinitions="Auto" ColumnDefinitions="*,*" Margin="0,2,0,2">
                                
                                <!-- Calibrador de Brillo HSL (Col 0) -->
                                <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,8,0">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0" Text="BRILLO HSL" FontSize="7" FontWeight="Black" LetterSpacing="1" Foreground="#52525B"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Lightness, StringFormat={}{0:F0}%}" FontSize="8" FontWeight="Bold" Foreground="#71717A" FontFamily="monospace"/>
                                    </Grid>
                                    <Slider Minimum="0" 
                                            Maximum="100" 
                                            Value="{Binding Lightness, Mode=TwoWay}"
                                            Foreground="White"
                                            Height="20"
                                            VerticalAlignment="Center"/>
                                </StackPanel>

                                <!-- Selector de Ruido Táctil (Col 1) -->
                                <StackPanel Grid.Column="1" Spacing="4" Margin="8,0,0,0">
                                    <TextBlock Text="RUIDO TÁCTIL (PAPEL ORGÁNICO)" FontSize="7" FontWeight="Black" LetterSpacing="1" Foreground="#52525B"/>
                                    <Border Background="#111113" Padding="2" CornerRadius="6" VerticalAlignment="Center">
                                        <Grid ColumnDefinitions="*,*,*">
                                            <ToggleButton Grid.Column="0" Content="OFF"
                                                          IsChecked="{Binding IsGrainNone, Mode=OneWay}"
                                                          Command="{Binding SwitchGrainLevelCommand}"
                                                          CommandParameter="0"
                                                          Height="18"
                                                          CornerRadius="4"
                                                          FontSize="7"
                                                          FontWeight="Black"
                                                          HorizontalContentAlignment="Center"
                                                          VerticalContentAlignment="Center"
                                                          BorderThickness="0">
                                                <ToggleButton.Styles>
                                                    <Style Selector="ToggleButton:checked /template/ ContentPresenter">
                                                        <Setter Property="Background" Value="White"/>
                                                        <Setter Property="Foreground" Value="Black"/>
                                                    </Style>
                                                    <Style Selector="ToggleButton:not(:checked) /template/ ContentPresenter">
                                                        <Setter Property="Background" Value="Transparent"/>
                                                        <Setter Property="Foreground" Value="#505050"/>
                                                    </Style>
                                                </ToggleButton.Styles>
                                            </ToggleButton>
                                            <ToggleButton Grid.Column="1" Content="FINO"
                                                          IsChecked="{Binding IsGrainFine, Mode=OneWay}"
                                                          Command="{Binding SwitchGrainLevelCommand}"
                                                          CommandParameter="1"
                                                          Height="18"
                                                          CornerRadius="4"
                                                          FontSize="7"
                                                          FontWeight="Black"
                                                          HorizontalContentAlignment="Center"
                                                          VerticalContentAlignment="Center"
                                                          BorderThickness="0">
                                                <ToggleButton.Styles>
                                                    <Style Selector="ToggleButton:checked /template/ ContentPresenter">
                                                        <Setter Property="Background" Value="White"/>
                                                        <Setter Property="Foreground" Value="Black"/>
                                                    </Style>
                                                    <Style Selector="ToggleButton:not(:checked) /template/ ContentPresenter">
                                                        <Setter Property="Background" Value="Transparent"/>
                                                        <Setter Property="Foreground" Value="#505050"/>
                                                    </Style>
                                                </ToggleButton.Styles>
                                            </ToggleButton>
                                            <ToggleButton Grid.Column="2" Content="TÁCT"
                                                          IsChecked="{Binding IsGrainTactile, Mode=OneWay}"
                                                          Command="{Binding SwitchGrainLevelCommand}"
                                                          CommandParameter="2"
                                                          Height="18"
                                                          CornerRadius="4"
                                                          FontSize="7"
                                                          FontWeight="Black"
                                                          HorizontalContentAlignment="Center"
                                                          VerticalContentAlignment="Center"
                                                          BorderThickness="0">
                                                <ToggleButton.Styles>
                                                    <Style Selector="ToggleButton:checked /template/ ContentPresenter">
                                                        <Setter Property="Background" Value="White"/>
                                                        <Setter Property="Foreground" Value="Black"/>
                                                    </Style>
                                                    <Style Selector="ToggleButton:not(:checked) /template/ ContentPresenter">
                                                        <Setter Property="Background" Value="Transparent"/>
                                                        <Setter Property="Foreground" Value="#505050"/>
                                                    </Style>
                                                </ToggleButton.Styles>
                                            </ToggleButton>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <!-- Divider Fino -->
                            <Border Height="1" Background="#161619"/>

                            <!-- Sección 4: Copiar código de especificación técnica (Specs) -->
                            <StackPanel Spacing="4">
                                <TextBlock Text="COPIAR ESPECIFICACIÓN TÉCNICA (CODE)" FontSize="7" FontWeight="Black" LetterSpacing="1" Foreground="#52525B"/>
                                <Grid ColumnDefinitions="*,*,*">
                                    <Button Grid.Column="0" Command="{Binding CopyCodeCommand}" CommandParameter="CSS"
                                            Background="#111113" Foreground="#A1A1AA" Height="22" Margin="0,0,4,0" CornerRadius="4" BorderBrush="#202023" BorderThickness="1">
                                        <TextBlock Text="CSS CORE" FontSize="7.5" FontWeight="Black" HorizontalAlignment="Center"/>
                                    </Button>
                                    <Button Grid.Column="1" Command="{Binding CopyCodeCommand}" CommandParameter="SWIFT"
                                            Background="#111113" Foreground="#A1A1AA" Height="22" Margin="2,0,2,0" CornerRadius="4" BorderBrush="#202023" BorderThickness="1">
                                        <TextBlock Text="SWIFTUI" FontSize="7.5" FontWeight="Black" HorizontalAlignment="Center"/>
                                    </Button>
                                    <Button Grid.Column="2" Command="{Binding CopyCodeCommand}" CommandParameter="KOTLIN"
                                            Background="#111113" Foreground="#A1A1AA" Height="22" Margin="4,0,0,0" CornerRadius="4" BorderBrush="#202023" BorderThickness="1">
                                        <TextBlock Text="KOTLIN" FontSize="7.5" FontWeight="Black" HorizontalAlignment="Center"/>
                                    </Button>
                                </Grid>
                            </StackPanel>

                            <!-- Divider Fino -->
                            <Border Height="1" Background="#161619"/>

                            <!-- Sección 5: Especificaciones de Render, OLED y Selector PC/CEL -->
                            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="ESPECIFICACIONES DE RENDIMIENTO" FontSize="6.5" FontWeight="Black" LetterSpacing="1" Foreground="#52525B"/>
                                    <!-- Celular Specs -->
                                    <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,1,0,0" IsVisible="{Binding IsSolidFormatMobile}">
                                        <TextBlock Text="CELULAR" FontSize="7.5" FontWeight="Black" Foreground="White"/>
                                        <TextBlock Text="•  1440 × 3200 PX" FontSize="7.5" FontWeight="Bold" Foreground="#71717A" FontFamily="monospace"/>
                                        <TextBlock Text="•" FontSize="8" Foreground="#27272A"/>
                                        <TextBlock Text="{Binding OledSavingText}" FontSize="7.5" FontWeight="Bold" Foreground="#A1A1AA" FontFamily="monospace"/>
                                    </StackPanel>
                                    <!-- PC Specs -->
                                    <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,1,0,0" IsVisible="{Binding IsSolidFormatPc}">
                                        <TextBlock Text="DESKTOP 4K" FontSize="7.5" FontWeight="Black" Foreground="White"/>
                                        <TextBlock Text="•  3840 × 2160 PX" FontSize="7.5" FontWeight="Bold" Foreground="#71717A" FontFamily="monospace"/>
                                        <TextBlock Text="•" FontSize="8" Foreground="#27272A"/>
                                        <TextBlock Text="{Binding OledSavingText}" FontSize="7.5" FontWeight="Bold" Foreground="#A1A1AA" FontFamily="monospace"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- PC / CELULAR Segmented Selector -->
                                <Border Grid.Column="1"
                                        Background="#111113"
                                        Padding="2"
                                        CornerRadius="6"
                                        VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="2">
                                        <ToggleButton Content="CEL"
                                                       IsChecked="{Binding IsSolidFormatMobile, Mode=OneWay}"
                                                       Command="{Binding SwitchSolidFormatCommand}"
                                                       CommandParameter="Móvil"
                                                       Height="20"
                                                       Width="32"
                                                       CornerRadius="4"
                                                       FontSize="7.5"
                                                       FontWeight="Black"
                                                       HorizontalAlignment="Stretch"
                                                       HorizontalContentAlignment="Center"
                                                       VerticalContentAlignment="Center"
                                                       BorderThickness="0">
                                            <ToggleButton.Styles>
                                                <Style Selector="ToggleButton:checked /template/ ContentPresenter">
                                                    <Setter Property="Background" Value="White"/>
                                                    <Setter Property="Foreground" Value="Black"/>
                                                </Style>
                                                <Style Selector="ToggleButton:not(:checked) /template/ ContentPresenter">
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Setter Property="Foreground" Value="#505050"/>
                                                </Style>
                                            </ToggleButton.Styles>
                                        </ToggleButton>
                                        <ToggleButton Content="PC"
                                                       IsChecked="{Binding IsSolidFormatPc, Mode=OneWay}"
                                                       Command="{Binding SwitchSolidFormatCommand}"
                                                       CommandParameter="PC"
                                                       Height="20"
                                                       Width="32"
                                                       CornerRadius="4"
                                                       FontSize="7.5"
                                                       FontWeight="Black"
                                                       HorizontalAlignment="Stretch"
                                                       HorizontalContentAlignment="Center"
                                                       VerticalContentAlignment="Center"
                                                       BorderThickness="0">
                                            <ToggleButton.Styles>
                                                <Style Selector="ToggleButton:checked /template/ ContentPresenter">
                                                    <Setter Property="Background" Value="White"/>
                                                    <Setter Property="Foreground" Value="Black"/>
                                                </Style>
                                                <Style Selector="ToggleButton:not(:checked) /template/ ContentPresenter">
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Setter Property="Foreground" Value="#505050"/>
                                                </Style>
                                            </ToggleButton.Styles>
                                        </ToggleButton>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Botón de descarga limpio y brutalista -->
                            <Button Command="{Binding DownloadSolidColorCommand}"
                                    Background="White"
                                    Foreground="Black"
                                    Height="40"
                                    CornerRadius="6"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    Margin="0,4,0,0">
                                <Button.Styles>
                                    <Style Selector="Button:pointerover /template/ ContentPresenter">
                                        <Setter Property="Background" Value="#E0E0E0"/>
                                        <Setter Property="Foreground" Value="Black"/>
                                    </Style>
                                </Button.Styles>
                                <TextBlock Text="GENERAR WALLPAPER SÓLIDO" FontSize="10.5" FontWeight="Bold" LetterSpacing="1"/>
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>

            </Grid>
        </Grid>

        <!-- PANEL MODAL: VISTA PREVIA DETALLADA + PALETTE EXTRACTOR + PRO TRANSITIONS -->
        <Grid Background="#FC08080C"
              IsVisible="{Binding SelectedWallpaper, Converter={x:Static ObjectConverters.IsNotNull}}"
              ZIndex="100"
              Opacity="1">
            <Grid.Transitions>
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.25"/>
                </Transitions>
            </Grid.Transitions>
            <Grid RowDefinitions="*,Auto" Margin="25,70,25,25">
                
                <!-- PREVISUALIZACIÓN DE IMAGEN INTELIGENTE (SMART PREVIEW) -->
                <Border Grid.Row="0"
                        Background="#0A0A0C"
                        BorderBrush="#1C1C1E"
                        BorderThickness="1"
                        CornerRadius="16"
                        ClipToBounds="True">
                    <Grid>
                        <!-- CAJÓN DE ESPECIFICACIONES TÉCNICAS BLUEPRINT (ⓘ) (Nivel Superior) -->
                        <Border HorizontalAlignment="Right"
                                VerticalAlignment="Stretch"
                                Width="260"
                                Background="#F208080C"
                                BorderBrush="#1C1C1E"
                                BorderThickness="1,0,0,0"
                                ZIndex="100"
                                IsVisible="{Binding IsTechSpecsDrawerOpen}">
                            <Grid RowDefinitions="Auto,*" Margin="20">
                                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,20">
                                    <StackPanel Grid.Column="0" Spacing="4">
                                        <TextBlock Text="TECHNICAL BLUEPRINT" FontSize="8" FontWeight="Black" LetterSpacing="2" Foreground="#8E8E93"/>
                                        <TextBlock Text="Ficha Cromática" FontSize="14" FontWeight="Bold" Foreground="White"/>
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Command="{Binding ToggleTechSpecsDrawerCommand}"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Width="30"
                                            Height="30"
                                            CornerRadius="15">
                                        <PathIcon Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z" Width="12" Height="12" Foreground="#8E8E93" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Button>
                                </Grid>
                                
                                <ScrollViewer Grid.Row="1">
                                    <StackPanel Spacing="20">
                                        <!-- Dimensión -->
                                        <StackPanel Spacing="6">
                                            <TextBlock Text="DIMENSIONES DE LIENZO" FontSize="7.5" FontWeight="Black" LetterSpacing="1.5" Foreground="#52525B"/>
                                            <Border Background="#121214" BorderBrush="#1C1C1E" BorderThickness="1" CornerRadius="6" Padding="12,10">
                                                <StackPanel Spacing="3">
                                                    <TextBlock Text="{Binding SelectedWpDimensions}" FontSize="12" FontWeight="Bold" Foreground="White" FontFamily="monospace"/>
                                                    <TextBlock Text="Renderizado ultra-nítido sin pérdida" FontSize="8" Foreground="#606062"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                        
                                        <!-- Perfil de Color -->
                                        <StackPanel Spacing="6">
                                            <TextBlock Text="PERFIL DE COLOR &amp; FORMATO" FontSize="7.5" FontWeight="Black" LetterSpacing="1.5" Foreground="#52525B"/>
                                            <Border Background="#121214" BorderBrush="#1C1C1E" BorderThickness="1" CornerRadius="6" Padding="12,10">
                                                <StackPanel Spacing="3">
                                                    <TextBlock Text="sRGB LOSSLESS PNG" FontSize="11" FontWeight="Bold" Foreground="White" FontFamily="monospace"/>
                                                    <TextBlock Text="Profundidad: 8-bit por canal (24-bit RGB)" FontSize="8" Foreground="#606062"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>

                                        <!-- Dominante Emocional -->
                                        <StackPanel Spacing="6">
                                            <TextBlock Text="DOMINANTE EMOCIONAL" FontSize="7.5" FontWeight="Black" LetterSpacing="1.5" Foreground="#52525B"/>
                                            <Border Background="#121214" BorderBrush="#1C1C1E" BorderThickness="1" CornerRadius="6" Padding="12,10">
                                                <StackPanel Spacing="3">
                                                    <TextBlock Text="{Binding SelectedWpMood}" FontSize="11" FontWeight="Bold" Foreground="#34C759" TextWrapping="Wrap"/>
                                                    <TextBlock Text="Calculado mediante firma cromática" FontSize="8" Foreground="#606062"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>

                                        <!-- Contraste Energético -->
                                        <StackPanel Spacing="6">
                                            <TextBlock Text="ENERGÍA CROMÁTICA" FontSize="7.5" FontWeight="Black" LetterSpacing="1.5" Foreground="#52525B"/>
                                            <Border Background="#121214" BorderBrush="#1C1C1E" BorderThickness="1" CornerRadius="6" Padding="12,10">
                                                <StackPanel Spacing="4">
                                                    <TextBlock Text="{Binding SelectedWpColorEnergy}" FontSize="11" FontWeight="Bold" Foreground="White" FontFamily="monospace"/>
                                                    <ProgressBar Value="75" Height="2" Minimum="0" Maximum="100" Background="#1C1C1E" Foreground="White" IsIndeterminate="False"/>
                                                    <TextBlock Text="Distribución de peso visual sRGB" FontSize="8" Foreground="#606062"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </Border>

                        <Viewbox Stretch="Uniform" Margin="20">
                            <Grid>
                                <!-- SMART PREVIEW: DESKTOP MAC (16:9) -->
                                <Border Width="1920" Height="1080"
                                        CornerRadius="16"
                                        ClipToBounds="True"
                                        BorderBrush="#252525"
                                        BorderThickness="8"
                                        IsVisible="{Binding IsDesktopWallpaperSelected}"
                                        BoxShadow="0 25 50 0 #A0000000">
                                    <Grid>
                                        <Image Source="{Binding SelectedWallpaper.ImageBitmap}" Stretch="UniformToFill"/>
                                        
                                        <!-- SIMULADOR DE ESCRITORIO MAC / PC DOCK & MENU (💻) -->
                                        <Grid IsVisible="{Binding IsDesktopOverlayVisible}" Background="Transparent" IsHitTestVisible="False">
                                            <!-- Sleek Top Translucent Mac Menu Bar -->
                                            <Border Height="35" VerticalAlignment="Top" Background="#AA08080A" BorderBrush="#1C1C1E" BorderThickness="0,0,0,1">
                                                <Grid ColumnDefinitions="Auto,*,Auto" Margin="24,0,24,0">
                                                    <!-- Left Menu Links -->
                                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="20" VerticalAlignment="Center">
                                                        <PathIcon Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-6h2v6zm0-8h-2V7h2v2z" Width="16" Height="16" Foreground="White" VerticalAlignment="Center"/>
                                                        <TextBlock Text="Finder" FontSize="14" Foreground="White" FontWeight="Black" VerticalAlignment="Center"/>
                                                        <TextBlock Text="Archivo" FontSize="14" Foreground="#8E8E93" FontWeight="Bold" VerticalAlignment="Center"/>
                                                        <TextBlock Text="Edición" FontSize="14" Foreground="#8E8E93" FontWeight="Bold" VerticalAlignment="Center"/>
                                                        <TextBlock Text="Visualización" FontSize="14" Foreground="#8E8E93" FontWeight="Bold" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    
                                                    <!-- Right Clock Info -->
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                                                        <TextBlock Text="📶" FontSize="14" Foreground="White" VerticalAlignment="Center" Opacity="0.8"/>
                                                        <TextBlock Text="🔋 100%" FontSize="14" Foreground="White" FontFamily="monospace" VerticalAlignment="Center" Opacity="0.8"/>
                                                        <TextBlock Text="Vie 09:41 AM" FontSize="14" Foreground="White" FontWeight="Black" FontFamily="monospace" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                            
                                            <!-- Minimal macOS Bottom App Dock -->
                                            <Border Height="80" Width="400" VerticalAlignment="Bottom" Margin="0,0,0,24" Background="#AA0E0E12" BorderBrush="#252528" BorderThickness="1" CornerRadius="28">
                                                <StackPanel Orientation="Horizontal" Spacing="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Border Width="48" Height="48" CornerRadius="12" Background="#FF3B30" BorderBrush="#CCFF3B30" BorderThickness="1"/>
                                                    <Border Width="48" Height="48" CornerRadius="12" Background="#34C759" BorderBrush="#CC34C759" BorderThickness="1"/>
                                                    <Border Width="48" Height="48" CornerRadius="12" Background="#007AFF" BorderBrush="#CC007AFF" BorderThickness="1"/>
                                                    <Border Width="48" Height="48" CornerRadius="12" Background="#FFCC00" BorderBrush="#CCFFCC00" BorderThickness="1"/>
                                                    <Border Width="48" Height="48" CornerRadius="12" Background="#AF52DE" BorderBrush="#CCAF52DE" BorderThickness="1"/>
                                                    <Border Width="48" Height="48" CornerRadius="12" Background="#5856D6" BorderBrush="#CC5856D6" BorderThickness="1"/>
                                                    
                                                    <Separator Width="1" Height="30" Background="#2C2C2E" Margin="8,0"/>
                                                    <Border Width="48" Height="48" CornerRadius="12" Background="#1C1C1E" BorderBrush="#2C2C2E" BorderThickness="1"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </Grid>
                                </Border>

                                <!-- SMART PREVIEW: MOBILE (9:16) -->
                                <Border Width="1080" Height="1920"
                                        CornerRadius="140"
                                        ClipToBounds="True"
                                        BorderBrush="#101010"
                                        BorderThickness="32"
                                        IsVisible="{Binding IsMobileWallpaperSelected}"
                                        BoxShadow="0 25 50 0 #A0000000">
                                    <Grid>
                                        <Image Source="{Binding SelectedWallpaper.ImageBitmap}" Stretch="UniformToFill"/>
                                        
                                        <!-- Dynamic Island Mockup -->
                                        <Border Width="300" Height="85" CornerRadius="42" Background="Black" VerticalAlignment="Top" Margin="0,30,0,0"/>

                                        <!-- SIMULADOR DE PANTALLA DE BLOQUEO (📱) -->
                                        <Grid IsVisible="{Binding IsLockScreenOverlayVisible}" Background="Transparent" IsHitTestVisible="False">
                                            <!-- Lock Icon -->
                                            <TextBlock Text="🔒" FontSize="36" Foreground="White" Opacity="0.75" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,180,0,0"/>
                                            
                                            <!-- Dynamic Clock -->
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,250,0,0" Spacing="10">
                                                <TextBlock Text="09:41" FontSize="260" FontWeight="Light" Foreground="White" HorizontalAlignment="Center" LetterSpacing="-5" FontFamily="Inter, -apple-system, sans-serif"/>
                                                <TextBlock Text="VIERNES, 23 DE MAYO" FontSize="36" FontWeight="Bold" LetterSpacing="6" Foreground="White" Opacity="0.75" HorizontalAlignment="Center" FontFamily="Inter, -apple-system, BlinkMacSystemFont, sans-serif"/>
                                            </StackPanel>
                                            
                                            <!-- Bottom Home Swipe Bar -->
                                            <Border Height="14" Width="400" Background="White" CornerRadius="7" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,40" Opacity="0.8"/>
                                        </Grid>
                                    </Grid>
                                </Border>
                                
                                <!-- CUADRÍCULA DE COMPOSICIÓN TÉCNICA / REGLA DE TERCIOS (📐) OVERLAY PARA AMBOS -->
                                <Grid IsVisible="{Binding IsCompositionGridVisible}" Background="Transparent" IsHitTestVisible="False">
                                    <Grid RowDefinitions="*,*,*" ColumnDefinitions="*,*,*">
                                        <Border Grid.Row="0" Grid.Column="0" BorderBrush="White" BorderThickness="0,0,2,2" Opacity="0.25"/>
                                        <Border Grid.Row="0" Grid.Column="1" BorderBrush="White" BorderThickness="0,0,2,2" Opacity="0.25"/>
                                        <Border Grid.Row="0" Grid.Column="2" BorderBrush="White" BorderThickness="0,0,0,2" Opacity="0.25"/>
                                        
                                        <Border Grid.Row="1" Grid.Column="0" BorderBrush="White" BorderThickness="0,0,2,2" Opacity="0.25"/>
                                        <Border Grid.Row="1" Grid.Column="1" BorderBrush="White" BorderThickness="0,0,2,2" Opacity="0.25"/>
                                        <Border Grid.Row="1" Grid.Column="2" BorderBrush="White" BorderThickness="0,0,0,2" Opacity="0.25"/>
                                    </Grid>
                                    <Ellipse Width="100" Height="100" Stroke="White" StrokeThickness="4" StrokeDashArray="2,2" Opacity="0.4" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Line StartPoint="-40,0" EndPoint="40,0" Stroke="White" StrokeThickness="4" Opacity="0.5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Line StartPoint="0,-40" EndPoint="0,40" Stroke="White" StrokeThickness="4" Opacity="0.5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </Grid>
                        </Viewbox>

                        <!-- Indicador de carga offline -->
                        <Border Background="#AA08080C"
                                CornerRadius="8"
                                Padding="10,6"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                IsVisible="{Binding SelectedWallpaper.ImageBitmap, Converter={x:Static ObjectConverters.IsNull}}">
                            <TextBlock Text="Cargando..." Foreground="#909090" FontSize="12"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- PANEL HUD INFERIOR DE DETALLE -->
                <StackPanel Grid.Row="1" Margin="0,20,0,0" Spacing="12">
                    
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding SelectedWallpaper.Title}"
                                       FontSize="20"
                                       FontWeight="Black"
                                       Foreground="White"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding SelectedWallpaper.Author}"
                                       FontSize="13"
                                       Foreground="#8E8E93"
                                       FontWeight="Medium"
                                       Margin="0,2,0,0"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        
                        <!-- Estadísticas B&W -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Spacing="12">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <PathIcon Data="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z" Width="12" Height="12" Foreground="White" Margin="0,0,4,0"/>
                                <TextBlock Text="{Binding SelectedWallpaper.Likes}" Foreground="#707070" FontSize="12"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <PathIcon Data="M19 9h-4V3H9v6H5l7 7 7-7zM5 18v2h14v-2H5z" Width="12" Height="12" Foreground="White" Margin="0,0,4,0"/>
                                <TextBlock Text="{Binding SelectedWallpaper.DownloadsCount}" Foreground="#707070" FontSize="12"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <!-- INNOVACIÓN EXCLUSIVA: PALETTE EXTRACTOR (EXTRACTOR DE PALETA ARMÓNICA) -->
                    <StackPanel Spacing="6" Margin="0,4,0,4">
                        <TextBlock Text="PALETA CROMÁTICA ARMÓNICA (CLICA PARA CARGAR EN RUEDA 3D)"
                                   FontSize="8"
                                   FontWeight="Bold"
                                   LetterSpacing="1.2"
                                   Foreground="#606060"/>
                        <ItemsControl ItemsSource="{Binding ExtractedColors}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="8"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding #RootWindow.DataContext.ApplyExtractedColorCommand}"
                                            CommandParameter="{Binding}"
                                            Width="46"
                                            Height="28"
                                            CornerRadius="6"
                                            BorderBrush="#252528"
                                            BorderThickness="1">
                                        <Button.Background>
                                            <SolidColorBrush Color="{Binding}"/>
                                        </Button.Background>
                                        <Button.Styles>
                                            <Style Selector="Button:pointerover">
                                                <Setter Property="BorderBrush" Value="White"/>
                                            </Style>
                                        </Button.Styles>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,0,0,0">
                        <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto,Auto" MinWidth="420">
                            <!-- BOTÓN DESCARGAR -->
                        <Button Grid.Column="0"
                                Command="{Binding DownloadCommand}"
                                CommandParameter="{Binding SelectedWallpaper}"
                                Background="White"
                                Foreground="Black"
                                Height="45"
                                CornerRadius="8"
                                Margin="0,0,8,0"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center">
                            <Button.Styles>
                                <Style Selector="Button:pointerover /template/ ContentPresenter">
                                    <Setter Property="Background" Value="#E0E0E0"/>
                                    <Setter Property="Foreground" Value="Black"/>
                                </Style>
                            </Button.Styles>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <PathIcon Data="M19 9h-4V3H9v6H5l7 7 7-7zM5 18v2h14v-2H5z" Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock Text="DESCARGAR WALLPAPER" FontSize="11" FontWeight="Bold" LetterSpacing="0.5"/>
                            </StackPanel>
                        </Button>

                        <!-- Toggle de favorito -->
                        <ToggleButton Grid.Column="1"
                                      IsChecked="{Binding SelectedWallpaper.IsFavorite, Mode=TwoWay}"
                                      Command="{Binding ToggleFavoriteCommand}"
                                      CommandParameter="{Binding SelectedWallpaper}"
                                      Width="45"
                                      Height="45"
                                      CornerRadius="8"
                                      Margin="0,0,8,0"
                                      Background="#121212"
                                      BorderBrush="#1C1C1E"
                                      BorderThickness="1"
                                      ToolTip.Tip="AÑADIR A FAVORITOS">
                            <ToggleButton.Styles>
                                <Style Selector="ToggleButton:checked /template/ ContentPresenter">
                                    <Setter Property="Background" Value="White"/>
                                    <Setter Property="BorderBrush" Value="White"/>
                                    <Setter Property="Foreground" Value="Black"/>
                                </Style>
                                <Style Selector="ToggleButton:not(:checked) /template/ ContentPresenter">
                                    <Setter Property="Background" Value="#121212"/>
                                    <Setter Property="BorderBrush" Value="#1C1C1E"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Style>
                            </ToggleButton.Styles>
                            <PathIcon Data="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z" Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </ToggleButton>

                        <!-- Toggle de simulador lockscreen (📱) -->
                        <ToggleButton Grid.Column="2"
                                      IsChecked="{Binding IsLockScreenOverlayVisible, Mode=TwoWay}"
                                      Width="45"
                                      Height="45"
                                      CornerRadius="8"
                                      Margin="0,0,8,0"
                                      Background="#121212"
                                      BorderBrush="#1C1C1E"
                                      BorderThickness="1"
                                      ToolTip.Tip="SIMULAR PANTALLA DE BLOQUEO iOS">
                            <ToggleButton.Styles>
                                <Style Selector="ToggleButton:checked /template/ ContentPresenter">
                                    <Setter Property="Background" Value="White"/>
                                    <Setter Property="BorderBrush" Value="White"/>
                                    <Setter Property="Foreground" Value="Black"/>
                                </Style>
                                <Style Selector="ToggleButton:not(:checked) /template/ ContentPresenter">
                                    <Setter Property="Background" Value="#121212"/>
                                    <Setter Property="BorderBrush" Value="#1C1C1E"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Style>
                            </ToggleButton.Styles>
                            <PathIcon Data="M17 1.01L7 1c-1.1 0-2 .9-2 2v18c0 1.1.9 2 2 2h10c1.1 0 2-.9 2-2V3c0-1.1-.9-1.99-2-1.99zM17 19H7V5h10v14z" Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </ToggleButton>

                        <!-- Toggle de simulador escritorio (💻) -->
                        <ToggleButton Grid.Column="3"
                                      IsChecked="{Binding IsDesktopOverlayVisible, Mode=TwoWay}"
                                      Width="45"
                                      Height="45"
                                      CornerRadius="8"
                                      Margin="0,0,8,0"
                                      Background="#121212"
                                      BorderBrush="#1C1C1E"
                                      BorderThickness="1"
                                      ToolTip.Tip="SIMULAR ESCRITORIO macOS">
                            <ToggleButton.Styles>
                                <Style Selector="ToggleButton:checked /template/ ContentPresenter">
                                    <Setter Property="Background" Value="White"/>
                                    <Setter Property="BorderBrush" Value="White"/>
                                    <Setter Property="Foreground" Value="Black"/>
                                </Style>
                                <Style Selector="ToggleButton:not(:checked) /template/ ContentPresenter">
                                    <Setter Property="Background" Value="#121212"/>
                                    <Setter Property="BorderBrush" Value="#1C1C1E"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Style>
                            </ToggleButton.Styles>
                            <PathIcon Data="M20 18c1.1 0 1.99-.9 1.99-2L22 6c0-1.1-.9-2-2-2H4c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2H0v2h24v-2h-4zM4 6h16v10H4V6z" Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </ToggleButton>

                        <!-- Toggle de cuadrícula de tercios (📐) -->
                        <ToggleButton Grid.Column="4"
                                      IsChecked="{Binding IsCompositionGridVisible, Mode=TwoWay}"
                                      Width="45"
                                      Height="45"
                                      CornerRadius="8"
                                      Margin="0,0,8,0"
                                      Background="#121212"
                                      BorderBrush="#1C1C1E"
                                      BorderThickness="1"
                                      ToolTip.Tip="REGLA DE COMPOSICIÓN (TERCIOS)">
                            <ToggleButton.Styles>
                                <Style Selector="ToggleButton:checked /template/ ContentPresenter">
                                    <Setter Property="Background" Value="White"/>
                                    <Setter Property="BorderBrush" Value="White"/>
                                    <Setter Property="Foreground" Value="Black"/>
                                </Style>
                                <Style Selector="ToggleButton:not(:checked) /template/ ContentPresenter">
                                    <Setter Property="Background" Value="#121212"/>
                                    <Setter Property="BorderBrush" Value="#1C1C1E"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Style>
                            </ToggleButton.Styles>
                            <PathIcon Data="M3 3v18h18V3H3zm16 16H5V5h14v14zM7 7h2v2H7V7zm4 0h2v2h-2V7zm4 0h2v2h-2V7zM7 11h2v2H7v-2zm4 0h2v2h-2v-2zm4 0h2v2h-2v-2zM7 15h2v2H7v-2zm4 0h2v2h-2v-2zm4 0h2v2h-2v-2z" Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </ToggleButton>

                        <!-- Toggle de cajón técnico Blueprint (ⓘ) -->
                        <ToggleButton Grid.Column="5"
                                      IsChecked="{Binding IsTechSpecsDrawerOpen, Mode=TwoWay}"
                                      Width="45"
                                      Height="45"
                                      CornerRadius="8"
                                      Margin="0,0,8,0"
                                      Background="#121212"
                                      BorderBrush="#1C1C1E"
                                      BorderThickness="1"
                                      ToolTip.Tip="ESPECIFICACIONES TÉCNICAS BLUEPRINT">
                            <ToggleButton.Styles>
                                <Style Selector="ToggleButton:checked /template/ ContentPresenter">
                                    <Setter Property="Background" Value="White"/>
                                    <Setter Property="BorderBrush" Value="White"/>
                                    <Setter Property="Foreground" Value="Black"/>
                                </Style>
                                <Style Selector="ToggleButton:not(:checked) /template/ ContentPresenter">
                                    <Setter Property="Background" Value="#121212"/>
                                    <Setter Property="BorderBrush" Value="#1C1C1E"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Style>
                            </ToggleButton.Styles>
                            <PathIcon Data="M11 7h2v2h-2zm0 4h2v6h-2zm1-9C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8z" Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </ToggleButton>

                        <!-- Botón cerrar -->
                        <Button Grid.Column="6"
                                Command="{Binding ClosePreviewCommand}"
                                Content="CERRAR"
                                Background="#121212"
                                Foreground="White"
                                BorderBrush="#1C1C1E"
                                BorderThickness="1"
                                FontWeight="Bold"
                                FontSize="11"
                                LetterSpacing="0.5"
                                Width="75"
                                Height="45"
                                CornerRadius="8"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center">
                            <Button.Styles>
                                <Style Selector="Button:pointerover /template/ ContentPresenter">
                                    <Setter Property="Background" Value="#1C1C1E"/>
                                    <Setter Property="BorderBrush" Value="#252528"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Style>
                            </Button.Styles>
                        </Button>
                    </Grid>
                    </ScrollViewer>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- ================= SPOTLIGHT COMMAND CENTER OVERLAY ================= -->
        <Grid Background="#D8000000"
              IsVisible="{Binding IsSpotlightOpen}"
              ZIndex="150">
            <Button Background="Transparent"
                    BorderThickness="0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Command="{Binding ToggleSpotlightCommand}"/>

            <Border Width="380"
                    Height="420"
                    Background="#121212"
                    BorderBrush="#252528"
                    BorderThickness="1"
                    CornerRadius="14"
                    BoxShadow="0 15 40 0 #A0000000"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Margin="0,0,0,100">
                <Grid RowDefinitions="Auto,Auto,*">
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="16,14,16,10">
                        <TextBox Grid.Column="0"
                                 PlaceholderText="Escribe un comando o acción..."
                                 Text="{Binding SpotlightQuery, Mode=TwoWay}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="White"
                                 FontSize="13"
                                 FontWeight="Medium"
                                 Padding="0,6"/>
                        <TextBlock Grid.Column="1"
                                   Text="⌘K"
                                   Foreground="#505050"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"/>
                    </Grid>
                    
                    <Border Grid.Row="1" Height="1" Background="#1C1C1E" Margin="0,0,0,8"/>

                    <ListBox Grid.Row="2"
                             ItemsSource="{Binding SpotlightActions}"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="8,0,8,8">
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,2"/>
                                <Setter Property="Background" Value="Transparent"/>
                            </Style>
                            <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                                <Setter Property="Background" Value="Transparent"/>
                            </Style>
                            <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                                <Setter Property="Background" Value="Transparent"/>
                            </Style>
                        </ListBox.Styles>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding #RootWindow.DataContext.ExecuteSpotlightActionCommand}"
                                        CommandParameter="{Binding}"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        CornerRadius="8"
                                        Padding="10,8"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch">
                                    <Button.Styles>
                                        <Style Selector="Button:pointerover /template/ ContentPresenter">
                                            <Setter Property="Background" Value="#1C1C1E"/>
                                        </Style>
                                    </Button.Styles>
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Grid.Column="0" Spacing="2">
                                            <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" Foreground="White"/>
                                            <TextBlock Text="{Binding Category}" FontSize="8" FontWeight="Bold" Foreground="#707070" LetterSpacing="0.5"/>
                                        </StackPanel>
                                        
                                        <Border Grid.Column="1"
                                                Background="#252528"
                                                CornerRadius="4"
                                                Padding="6,3"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ShortcutText}" FontSize="8" FontWeight="Black" Foreground="#A0A0A0"/>
                                        </Border>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>

        <!-- ================= ADJUSTES COLLAPSIBLE SETTINGS DRAWER (INNOVACIÓN PRO) ================= -->
        <Grid Background="#70000000"
              IsVisible="{Binding IsSettingsOpen}"
              ZIndex="120">
            
            <!-- Clic fuera del Drawer para cerrar -->
            <Button Background="Transparent"
                    BorderThickness="0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Command="{Binding ToggleSettingsCommand}"/>

            <!-- Panel Lateral Deslizable (Settings Drawer) -->
            <Border Width="325"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Stretch"
                    Background="#EC08080C"
                    BorderBrush="#1C1C1E"
                    BorderThickness="1,0,0,0"
                    Padding="20,55,20,20"
                    BoxShadow="-15 0 35 0 #80000000">
                
                <Grid RowDefinitions="Auto,*">
                    <!-- Cabecera del Drawer -->
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,15">
                        <TextBlock Grid.Column="0"
                                   Text="CONFIGURACIÓN"
                                   FontSize="10"
                                   FontWeight="Black"
                                   LetterSpacing="2"
                                   Foreground="White"
                                   VerticalAlignment="Center"/>
                        
                        <Button Grid.Column="1"
                                Command="{Binding ToggleSettingsCommand}"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="4">
                            <PathIcon Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z" Width="14" Height="14" Foreground="#707070" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </Grid>

                    <!-- Scroll de Opciones -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="16">
                            
                            <!-- SECCIÓN 0: GITHUB CLOUD ENGINE -->
                            <Border Background="#121212"
                                    BorderBrush="#1C1C1E"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="14">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="NUBE GITHUB" FontSize="8" FontWeight="Black" LetterSpacing="2" Foreground="#707070"/>
                                    
                                    <StackPanel Spacing="8">
                                        <StackPanel>
                                            <TextBlock Text="Usuario de GitHub" FontSize="9" Foreground="#606060" Margin="0,0,0,3"/>
                                            <TextBox Text="{Binding GithubUsername, Mode=TwoWay}" PlaceholderText="User..." Height="30" FontSize="11" Background="#1C1C1E" BorderBrush="#252528" Padding="6,4" CornerRadius="5"/>
                                        </StackPanel>

                                        <StackPanel>
                                            <TextBlock Text="Token PAT" FontSize="9" Foreground="#606060" Margin="0,0,0,3"/>
                                            <TextBox Text="{Binding GithubToken, Mode=TwoWay}" PasswordChar="●" PlaceholderText="ghp_..." Height="30" FontSize="11" Background="#1C1C1E" BorderBrush="#252528" Padding="6,4" CornerRadius="5"/>
                                        </StackPanel>

                                        <StackPanel>
                                            <TextBlock Text="Propietario del Repo" FontSize="9" Foreground="#606060" Margin="0,0,0,3"/>
                                            <TextBox Text="{Binding RepoOwner, Mode=TwoWay}" PlaceholderText="Owner..." Height="30" FontSize="11" Background="#1C1C1E" BorderBrush="#252528" Padding="6,4" CornerRadius="5"/>
                                        </StackPanel>

                                        <StackPanel>
                                            <TextBlock Text="Nombre del Repo" FontSize="9" Foreground="#606060" Margin="0,0,0,3"/>
                                            <TextBox Text="{Binding RepoName, Mode=TwoWay}" PlaceholderText="Repo..." Height="30" FontSize="11" Background="#1C1C1E" BorderBrush="#252528" Padding="6,4" CornerRadius="5"/>
                                        </StackPanel>
                                        
                                        <Border Height="1" Background="#1C1C1E" Margin="0,4"/>

                                        <StackPanel>
                                            <TextBlock Text="Gemini API Key (Para IA)" FontSize="9" Foreground="#606060" Margin="0,0,0,3"/>
                                            <TextBox Text="{Binding GeminiToken, Mode=TwoWay}" PasswordChar="●" PlaceholderText="AIzaSy..." Height="30" FontSize="11" Background="#1C1C1E" BorderBrush="#252528" Padding="6,4" CornerRadius="5"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Privilegio actual calculado -->
                                    <Border Background="#1C1C1E" CornerRadius="5" Padding="8" Margin="0,4,0,4">
                                        <TextBlock Text="{Binding UserRoleText}" FontSize="8" FontWeight="Black" Foreground="White" HorizontalAlignment="Center"/>
                                    </Border>

                                    <Button Command="{Binding AuthenticateGithubCommand}"
                                            Content="CONECTAR NUBE"
                                            Background="White"
                                            Foreground="Black"
                                            Height="35"
                                            CornerRadius="6"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Center"
                                            VerticalContentAlignment="Center"
                                            FontSize="10"
                                            FontWeight="Bold">
                                        <Button.Styles>
                                            <Style Selector="Button:pointerover /template/ ContentPresenter">
                                                <Setter Property="Background" Value="#E0E0E0"/>
                                                <Setter Property="Foreground" Value="Black"/>
                                            </Style>
                                        </Button.Styles>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <!-- SECCIÓN 0.5: HERRAMIENTAS DE CREADOR (EDITORES Y ADMINS A/B) -->
                            <Border Background="#121212"
                                    BorderBrush="#1C1C1E"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="14"
                                    IsVisible="{Binding IsLevelBOrAbove}">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="CREADOR ENGINE" FontSize="8" FontWeight="Black" LetterSpacing="2" Foreground="#FF3B30"/>
                                    
                                    <StackPanel Spacing="8">
                                        <StackPanel>
                                            <TextBlock Text="Título del Wallpaper" FontSize="9" Foreground="#606060" Margin="0,0,0,3"/>
                                            <TextBox Text="{Binding NewWpTitle, Mode=TwoWay}" PlaceholderText="Ej. Brutalism..." Height="30" FontSize="11" Background="#1C1C1E" BorderBrush="#252528" Padding="6,4" CornerRadius="5"/>
                                        </StackPanel>

                                        <StackPanel>
                                            <TextBlock Text="Autor (@crédito)" FontSize="9" Foreground="#606060" Margin="0,0,0,3"/>
                                            <TextBox Text="{Binding NewWpAuthor, Mode=TwoWay}" PlaceholderText="Ej. @creador..." Height="30" FontSize="11" Background="#1C1C1E" BorderBrush="#252528" Padding="6,4" CornerRadius="5"/>
                                        </StackPanel>

                                        <Grid ColumnDefinitions="*,*">
                                            <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                                <TextBlock Text="Categoría" FontSize="9" Foreground="#606060" Margin="0,0,0,3"/>
                                                <ComboBox SelectedItem="{Binding NewWpCategory}" IsEnabled="False" Height="30" HorizontalAlignment="Stretch" Background="#1C1C1E" BorderBrush="#252528" CornerRadius="5" FontSize="10">
                                                    <sys:String>Minimalista</sys:String>
                                                    <sys:String>Arquitectura</sys:String>
                                                    <sys:String>Texturas</sys:String>
                                                    <sys:String>Líneas</sys:String>
                                                    <sys:String>Paisaje</sys:String>
                                                    <sys:String>Cyberpunk</sys:String>
                                                    <sys:String>Abstracto</sys:String>
                                                    <sys:String>Fotografía</sys:String>
                                                    <sys:String>Otro</sys:String>
                                                </ComboBox>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                                <TextBlock Text="Dispositivo (Automático)" FontSize="9" Foreground="#606060" Margin="0,0,0,3"/>
                                                <ComboBox SelectedItem="{Binding NewWpDeviceType}" IsEnabled="False" Height="30" HorizontalAlignment="Stretch" Background="#1C1C1E" BorderBrush="#252528" CornerRadius="5" FontSize="10">
                                                    <sys:String>Móvil</sys:String>
                                                    <sys:String>Desktop</sys:String>
                                                </ComboBox>
                                            </StackPanel>
                                        </Grid>

                                        <StackPanel>
                                            <TextBlock Text="Ruta local o URL web" FontSize="9" Foreground="#606060" Margin="0,0,0,3"/>
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBox Grid.Column="0"
                                                         Text="{Binding NewWpImagePath, Mode=TwoWay}"
                                                         PlaceholderText="Ruta/URL..."
                                                         Height="30"
                                                         FontSize="11"
                                                         Background="#1C1C1E"
                                                         BorderBrush="#252528"
                                                         Padding="6,4"
                                                         CornerRadius="5"/>
                                                <Button Grid.Column="1"
                                                        Command="{Binding SelectLocalFileCommand}"
                                                        Content="Examinar..."
                                                        Height="30"
                                                        FontSize="10"
                                                        FontWeight="Bold"
                                                        Background="#252528"
                                                        Foreground="White"
                                                        Margin="6,0,0,0"
                                                        Padding="12,0"
                                                        CornerRadius="5"
                                                        VerticalContentAlignment="Center">
                                                    <Button.Styles>
                                                        <Style Selector="Button:pointerover /template/ ContentPresenter">
                                                            <Setter Property="Background" Value="#3A3A3C"/>
                                                            <Setter Property="Foreground" Value="White"/>
                                                        </Style>
                                                    </Button.Styles>
                                                </Button>
                                            </Grid>
                                        </StackPanel>
                                    </StackPanel>

                                    <Button Command="{Binding UploadNewWallpaperCommand}"
                                            Content="PUBLICAR EN NUBE"
                                            Background="#FF3B30"
                                            Foreground="White"
                                            Height="35"
                                            CornerRadius="6"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Center"
                                            VerticalContentAlignment="Center"
                                            FontSize="10"
                                            FontWeight="Bold">
                                        <Button.Styles>
                                            <Style Selector="Button:pointerover /template/ ContentPresenter">
                                                <Setter Property="Background" Value="#E03028"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </Style>
                                        </Button.Styles>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <!-- SECCIÓN 1: PREFERENCIAS DE DESCARGA -->
                            <Border Background="#121212"
                                    BorderBrush="#1C1C1E"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="14">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="DESCARGAS" FontSize="8" FontWeight="Black" LetterSpacing="2" Foreground="#707070"/>
                                    
                                    <Grid ColumnDefinitions="*,Auto" Margin="0,2,0,2">
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="Resolución" FontSize="12" FontWeight="SemiBold" Foreground="White"/>
                                            <TextBlock Text="Calidad de sólidos." FontSize="9" Foreground="#606060" Margin="0,1,0,0"/>
                                        </StackPanel>
                                        
                                        <ComboBox Grid.Column="1"
                                                  SelectedItem="{Binding DownloadQuality}"
                                                  Width="95"
                                                  Height="28"
                                                  Background="#1C1C1E"
                                                  BorderBrush="#252528"
                                                  CornerRadius="5"
                                                  FontSize="10">
                                            <ComboBoxItem Content="Original"/>
                                            <ComboBoxItem Content="Media"/>
                                            <ComboBoxItem Content="Baja"/>
                                        </ComboBox>
                                    </Grid>

                                    <Separator Height="1" Background="#1C1C1E"/>

                                    <StackPanel Spacing="3" Margin="0,2,0,0">
                                        <TextBlock Text="Carpeta física de guardado" FontSize="11" FontWeight="SemiBold" Foreground="White"/>
                                        <Border Background="#1C1C1E" BorderBrush="#252528" BorderThickness="1" CornerRadius="5" Padding="8,6">
                                            <TextBlock Text="{Binding DownloadPath}" FontSize="9" Foreground="#808080" FontFamily="monospace" TextTrimming="CharacterEllipsis"/>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- SECCIÓN 2: ASPECTO -->
                            <Border Background="#121212"
                                    BorderBrush="#1C1C1E"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="14">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="TEMA DE APLICACIÓN" FontSize="8" FontWeight="Black" LetterSpacing="2" Foreground="#707070"/>
                                    
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="Negro AMOLED" FontSize="12" FontWeight="SemiBold" Foreground="White"/>
                                            <TextBlock Text="Fondo oscuro absoluto." FontSize="9" Foreground="#606060" Margin="0,1,0,0"/>
                                        </StackPanel>
                                        
                                        <ToggleSwitch Grid.Column="1"
                                                      IsChecked="{Binding PureContrastMode, Mode=TwoWay}"
                                                      OnContent=""
                                                      OffContent=""
                                                      MinWidth="0"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- SECCIÓN 3: CACHÉ -->
                            <Border Background="#121212"
                                    BorderBrush="#1C1C1E"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="14">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="MANTENIMIENTO" FontSize="8" FontWeight="Black" LetterSpacing="2" Foreground="#707070"/>
                                    
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="Tamaño de Caché" FontSize="12" FontWeight="SemiBold" Foreground="White"/>
                                            <TextBlock Text="{Binding CacheSizeText}" FontSize="10" Foreground="#808080" Margin="0,1,0,0"/>
                                        </StackPanel>
                                        
                                        <Button Grid.Column="1"
                                                Command="{Binding ClearCacheCommand}"
                                                Content="LIMPIAR"
                                                Background="Transparent"
                                                BorderBrush="#FF3B30"
                                                BorderThickness="1"
                                                Foreground="#FF3B30"
                                                FontSize="9"
                                                FontWeight="Bold"
                                                Padding="10,5"
                                                CornerRadius="5">
                                            <Button.Styles>
                                                <Style Selector="Button:pointerover /template/ ContentPresenter">
                                                    <Setter Property="Background" Value="#1AFF3B30"/>
                                                    <Setter Property="BorderBrush" Value="#FF3B30"/>
                                                    <Setter Property="Foreground" Value="#FF3B30"/>
                                                </Style>
                                            </Button.Styles>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- ================= MODO PRESENTACIÓN AMBIENT SLIDESHOW FULLSCREEN OVERLAY ================= -->
        <Grid Background="#FC08080C"
              IsVisible="{Binding IsSlideshowActive}"
              ZIndex="180"
              Opacity="1">
            <Grid.Transitions>
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.35"/>
                </Transitions>
            </Grid.Transitions>
            
            <!-- Wallpaper de Fondo con Shroud Oscuro -->
            <Image Source="{Binding SlideshowCurrentWp.ImageBitmap}"
                   Stretch="UniformToFill"
                   Opacity="0.45"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"/>

            <!-- Sombreado Brutalista inferior y superior para controles -->
            <Border VerticalAlignment="Bottom" Height="140">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#00000000" Offset="0"/>
                        <GradientStop Color="#FC08080C" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <!-- CONTENIDO CENTRAL: CRONÓMETRO SWISS POMODORO FOCUS -->
            <Grid VerticalAlignment="Center" HorizontalAlignment="Center" RowDefinitions="Auto,Auto,Auto" IsVisible="{Binding IsFocusTimerActive}">
                <!-- Modo actual: CONCENTRACIÓN (Blanco) o DESCANSO (Rojo) -->
                <Border Grid.Row="0"
                        Background="#1A121214"
                        BorderBrush="#33FFFFFF"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="10,4"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <PathIcon Data="M19.14,12.94c0.04-0.3,0.06-0.61,0.06-0.94c0-0.32-0.02-0.64-0.06-0.94l2.03-1.58c0.18-0.14,0.23-0.41,0.12-0.61 l-1.92-3.32c-0.12-0.22-0.37-0.29-0.59-0.22l-2.39,0.96c-0.5-0.38-1.03-0.7-1.62-0.94L14.4,2.81c-0.04-0.24-0.24-0.41-0.48-0.41 h-3.84c-0.24,0-0.43,0.17-0.47,0.41L9.25,5.35C8.66,5.59,8.12,5.92,7.63,6.29L5.24,5.33c-0.22-0.08-0.47,0-0.59,0.22L2.73,8.87 C2.62,9.08,2.66,9.34,2.86,9.48l2.03,1.58C4.84,11.36,4.8,11.69,4.8,12s0.02,0.64,0.06,0.94l-2.03,1.58 c-0.18,0.14-0.23,0.41-0.12,0.61l1.92,3.32c0.12,0.22,0.37,0.29,0.59,0.22l2.39-0.96c0.5,0.38,1.03,0.7,1.62,0.94l0.36,2.54 c0.05,0.24,0.24,0.41,0.48,0.41h3.84c0.24,0,0.43-0.17,0.47-0.41l0.36-2.54c0.59-0.24,1.13-0.56,1.62-0.94l2.39,0.96 c0.22,0.08,0.47,0,0.59-0.22l1.92-3.32c0.12-0.22,0.07-0.49-0.12-0.61L19.14,12.94z M12,15.6c-1.98,0-3.6-1.62-3.6-3.6 s1.62-3.6,3.6-3.6s3.6,1.62,3.6,3.6S13.98,15.6,12,15.6z" Width="10" Height="10" Foreground="#8E8E93" VerticalAlignment="Center"/>
                            <TextBlock Text="STATUS:" FontSize="8" FontWeight="Black" LetterSpacing="1" Foreground="#8E8E93" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="{Binding FocusTimerMode}" FontSize="8.5" FontWeight="Black" LetterSpacing="1.5" Foreground="White" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Gran Reloj Monospace -->
                <TextBlock Grid.Row="1"
                           Text="{Binding FocusTimerText}"
                           FontSize="96"
                           FontWeight="Light"
                           Foreground="White"
                           LetterSpacing="-2"
                           FontFamily="monospace, Courier New, Inter, -apple-system, sans-serif"
                           HorizontalAlignment="Center"/>

                <!-- Minimalist progress bar -->
                <ProgressBar Grid.Row="2"
                             Value="{Binding FocusTimerProgressPercent}"
                             Minimum="0"
                             Maximum="100"
                             Height="2"
                             Width="200"
                             Background="#33FFFFFF"
                             Foreground="White"
                             HorizontalAlignment="Center"
                             Margin="0,16,0,0"/>
            </Grid>

            <!-- BARRA DE CONTROLES INFERIOR BRUTALISTA -->
            <Border VerticalAlignment="Bottom"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,40"
                    Background="#EE0E0E12"
                    BorderBrush="#252528"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="14,10"
                    Width="480">
                <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto,Auto,*">
                    <!-- Título del Wallpaper actual -->
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="8,0,0,0">
                        <TextBlock Text="{Binding SlideshowCurrentWp.Title}" FontSize="11" FontWeight="Bold" Foreground="White" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding SlideshowCurrentWp.Author}" FontSize="8" Foreground="#707070" Margin="0,1,0,0"/>
                    </StackPanel>

                    <!-- Botones de Control del Temporizador Focus -->
                    <ToggleButton Grid.Column="1"
                                  IsChecked="{Binding IsFocusTimerActive, Mode=TwoWay}"
                                  Width="34"
                                  Height="34"
                                  CornerRadius="6"
                                  Margin="0,0,6,0"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  ToolTip.Tip="MOSTRAR/OCULTAR TEMPORIZADOR FOCUS">
                        <ToggleButton.Styles>
                            <Style Selector="ToggleButton:checked PathIcon">
                                <Setter Property="Foreground" Value="White"/>
                            </Style>
                            <Style Selector="ToggleButton:not(:checked) PathIcon">
                                <Setter Property="Foreground" Value="#606060"/>
                            </Style>
                        </ToggleButton.Styles>
                        <PathIcon Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67z" Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </ToggleButton>

                    <!-- Iniciar/Pausar Temporizador Pomodoro -->
                    <ToggleButton Grid.Column="2"
                                  IsVisible="{Binding IsFocusTimerActive}"
                                  IsChecked="{Binding IsFocusTimerRunning, Mode=TwoWay}"
                                  Width="34"
                                  Height="34"
                                  CornerRadius="6"
                                  Margin="0,0,6,0"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  ToolTip.Tip="INICIAR/PAUSAR FOCUS TIMER">
                        <ToggleButton.Styles>
                            <Style Selector="ToggleButton:checked PathIcon">
                                <Setter Property="Data" Value="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/>
                                <Setter Property="Foreground" Value="#34C759"/>
                            </Style>
                            <Style Selector="ToggleButton:not(:checked) PathIcon">
                                <Setter Property="Data" Value="M8 5v14l11-7z"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Style>
                        </ToggleButton.Styles>
                        <PathIcon Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </ToggleButton>

                    <!-- Reset del Temporizador Pomodoro -->
                    <Button Grid.Column="3"
                            IsVisible="{Binding IsFocusTimerActive}"
                            Command="{Binding ResetFocusTimerCommand}"
                            Width="34"
                            Height="34"
                            CornerRadius="6"
                            Margin="0,0,16,0"
                            Background="Transparent"
                            BorderThickness="0"
                            ToolTip.Tip="REINICIAR FOCUS TIMER">
                        <PathIcon Data="M12 4V1L8 5l4 4V6c3.31 0 6 2.69 6 6 0 3.31-2.69 6-6 6s-6-2.69-6-6H4c0 4.42 3.58 8 8 8s8-3.58 8-8-3.58-8-8-8z" Width="14" Height="14" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>

                    <Separator Grid.Column="4" Width="1" Height="20" Background="#2C2C2E" Margin="0,0,16,0"/>

                    <!-- Control del Slideshow manual -->
                    <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="6">
                        <!-- Anterior -->
                        <Button Command="{Binding PrevSlideshowCommand}"
                                Width="34"
                                Height="34"
                                CornerRadius="6"
                                Background="Transparent"
                                BorderThickness="0"
                                ToolTip.Tip="WALLPAPER ANTERIOR">
                            <PathIcon Data="M15.41 7.41L14 6l-6 6 6 6 1.41-1.41L10.83 12z" Width="12" Height="12" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                        <!-- Reproducir/Pausar Bucle -->
                        <ToggleButton IsChecked="{Binding IsSlideshowPlaying, Mode=TwoWay}"
                                      Width="34"
                                      Height="34"
                                      CornerRadius="6"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      ToolTip.Tip="REPRODUCIR/PAUSAR SLIDESHOW">
                            <ToggleButton.Styles>
                                <Style Selector="ToggleButton:checked PathIcon">
                                    <Setter Property="Data" Value="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/>
                                </Style>
                                <Style Selector="ToggleButton:not(:checked) PathIcon">
                                    <Setter Property="Data" Value="M8 5v14l11-7z"/>
                                </Style>
                            </ToggleButton.Styles>
                            <PathIcon Width="12" Height="12" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </ToggleButton>
                        <!-- Siguiente -->
                        <Button Command="{Binding NextSlideshowCommand}"
                                Width="34"
                                Height="34"
                                CornerRadius="6"
                                Background="Transparent"
                                BorderThickness="0"
                                ToolTip.Tip="WALLPAPER SIGUIENTE">
                            <PathIcon Data="M10 6L8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z" Width="12" Height="12" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </StackPanel>

                    <!-- Salir de la Presentación -->
                    <Button Grid.Column="6"
                            Command="{Binding ToggleSlideshowCommand}"
                            Width="34"
                            Height="34"
                            CornerRadius="6"
                            Margin="16,0,0,0"
                            Background="#EEFF3B30"
                            BorderBrush="#FF3B30"
                            BorderThickness="1"
                            ToolTip.Tip="CERRAR PRESENTACIÓN">
                        <PathIcon Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z" Width="12" Height="12" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                </Grid>
            </Border>
        </Grid>

        <!-- BANNER DE NOTIFICACIONES TOAST MINIMALISTA -->
        <Border VerticalAlignment="Top"
                HorizontalAlignment="Center"
                Margin="0,60,0,0"
                Background="#121212"
                BorderBrush="White"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16,8"
                ZIndex="200"
                IsVisible="{Binding IsToastVisible}"
                BoxShadow="0 4 15 0 #90000000">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <PathIcon Data="M11.5 2L3 13h7v9l8.5-11h-7z" Width="12" Height="12" Foreground="White" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding ToastMessage}" Foreground="White" FontSize="11" FontWeight="Bold" LetterSpacing="0.5"/>
            </StackPanel>
        </Border>
    </Grid>

</Window>